# Chrome extension load: never commit underscore-prefixed files in extension root (use server_logs/ or scripts/ instead)
# Chrome MV3: filenames starting with "_" block "Load unpacked" except _locales and _metadata
/_*.log
/_*.py
/_restart*
tools/__pycache__/
metadata_store/**/_ruleset*
