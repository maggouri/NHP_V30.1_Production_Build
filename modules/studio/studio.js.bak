    repo: {
        get grid() { return document.getElementById('repo-items-grid'); },
        get count() { return document.getElementById('repo-count-status'); },
        get qty() { return document.getElementById('repo-transfer-qty'); },
        items: []
    }
};

// References to global functions/objects passed during init
