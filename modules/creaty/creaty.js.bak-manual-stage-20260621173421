function renderCreatyFloatingCard() {
  const card = $('creaty-floating-card');
  const floatingSelect = $('creaty-floating-card-account');
  const storeSelect = $('creaty-store-account');
  if (!card || !floatingSelect || !storeSelect) return;

  const options = Array.from(storeSelect.options || []).map((opt) => ({
    value: String(opt.value || ''),
    label: String(opt.textContent || ''),
  }));
  const prevValue = floatingSelect.value;
  floatingSelect.innerHTML = options.map((opt) => (
    `<option value="${opt.value.replace(/"/g, '&quot;')}">${opt.label}</option>`
  )).join('');
  floatingSelect.value = storeSelect.value || prevValue || '';

  const email = String(storeSelect.value || floatingSelect.value || '').trim();
  const account = [
    ...allStoreAccounts,
    ...activatedAccounts,
    ...importedSessionsCache,
  ].find((acc) => String(acc?.email || '').trim().toLowerCase() === email.toLowerCase()) || null;

  let profile = null;
  if (email && storeSelect.value && storeSelect.value.toLowerCase() === email.toLowerCase()) {
    const draft = readStoreFormProfile();
    if (draft.title || draft.bio || draft.niche || draft.avatarDataUrl || draft.coverDataUrl) profile = draft;
  }
  if (!profile) profile = storeProfileDraft || null;
  if (!profile || (email && email.toLowerCase() !== String(storeSelect.value || '').trim().toLowerCase())) {
    if (storeProfileDraft && email && email.toLowerCase() === String(storeSelect.value || '').trim().toLowerCase()) {
      profile = storeProfileDraft;
    }
  }

  $('creaty-floating-card-email').textContent = email || '—';
  $('creaty-floating-card-name').textContent = account
    ? [account.firstName || account.first_name || '', account.lastName || account.last_name || ''].join(' ').trim() || '—'
    : '—';
  $('creaty-floating-card-title').textContent = profile?.title || account?.storeName || '—';
  $('creaty-floating-card-niche').textContent = profile?.niche || '—';
  $('creaty-floating-card-bio').textContent = profile?.bio || 'لا توجد بيانات متجر بعد.';
  renderFloatingCardImage('creaty-floating-card-avatar', profile?.avatarDataUrl || null, 'لا Avatar');
  renderFloatingCardImage('creaty-floating-card-cover', profile?.coverDataUrl || null, 'لا Cover');

  const status = $('creaty-store-status')?.textContent?.trim();
  $('creaty-floating-card-status').textContent = email
    ? (status || `الحساب الحالي: ${email}`)
    : 'اختر حسابًا لعرض بيانات المتجر.';
}

