function wireImportedSessionsWheelScroll() {
  const wrap = document.querySelector('.creaty-imported-table-wrap');
  if (!wrap || wrap.dataset.wheelBound === '1') return;
  wrap.dataset.wheelBound = '1';
  wrap.addEventListener('wheel', (event) => {
    const deltaY = Number(event.deltaY || 0);
    if (!deltaY) return;
    const nextTop = wrap.scrollTop + deltaY;
    const maxTop = wrap.scrollHeight - wrap.clientHeight;
    if (maxTop <= 0) return;
    wrap.scrollTop = Math.max(0, Math.min(maxTop, nextTop));
    event.preventDefault();
  }, { passive: false });
}

