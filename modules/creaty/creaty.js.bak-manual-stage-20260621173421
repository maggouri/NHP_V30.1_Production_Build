function parseIsoDate(iso) {
  const parts = String(iso || '').split('-').map(Number);
  if (parts.length !== 3 || parts.some((n) => Number.isNaN(n))) return null;
  return new Date(parts[0], parts[1] - 1, parts[2]);
}

function daysSinceStart(schedule) {
  const start = parseIsoDate(schedule?.startDate);
  if (!start) return 0;
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  start.setHours(0, 0, 0, 0);
  const diff = Math.floor((today - start) / 86400000);
  return Math.max(0, diff);
}

function calendarDayFromSchedule(schedule) {
  if (!schedule?.started || schedule.paused) return schedule?.currentDay || 1;
  const gap = Math.max(1, Number(schedule.daysBetween) || 2);
  const elapsed = daysSinceStart(schedule);
  const computed = Math.min(ARTISAN_PLAN_DAYS, Math.floor(elapsed / gap) + 1);
  return Math.max(schedule.currentDay || 1, computed);
}

function phaseForDay(day, schedule) {
  const designCount = Math.min(ARTISAN_MAX_DESIGNS, Number(schedule?.designCount) || ARTISAN_MAX_DESIGNS);
  const designPhases = ARTISAN_PHASE_DEFS.filter((d) => d.isDesign);
  const allowedDesignIds = new Set(designPhases.slice(0, designCount).map((d) => d.id));
  return ARTISAN_PHASE_DEFS.find((def) => {
    if (def.isDesign && !allowedDesignIds.has(def.id)) return false;
    return day >= def.dayStart && day <= def.dayEnd;
  }) || null;
}

function effectivePhaseStatus(phase, schedule, calendarDay) {
  if (!phase) return 'pending';
  const stored = schedule.phases.find((p) => p.id === phase.id);
  if (!stored) return 'pending';
  if (stored.status === 'done' || stored.status === 'skipped') return stored.status;
  if (!schedule.started) return 'pending';
  if (calendarDay >= phase.dayStart && calendarDay <= phase.dayEnd) return 'in_progress';
  if (calendarDay > phase.dayEnd) return stored.status === 'pending' ? 'pending' : stored.status;
  return 'pending';
}

function countProgress(schedule) {
  const calendarDay = calendarDayFromSchedule(schedule);
  const designCount = Math.min(ARTISAN_MAX_DESIGNS, Number(schedule?.designCount) || ARTISAN_MAX_DESIGNS);
  let daysDone = 0;
  let designsDone = 0;

  ARTISAN_PHASE_DEFS.forEach((def) => {
    const stored = schedule.phases.find((p) => p.id === def.id);
    const status = stored?.status || 'pending';
    if (status === 'done') {
      daysDone += def.dayEnd - def.dayStart + 1;
      if (def.isDesign && def.id !== 'design5_review') designsDone += 1;
      if (def.id === 'design5_review') designsDone += 1;
    } else if (status === 'skipped') {
      daysDone += def.dayEnd - def.dayStart + 1;
    }
  });

  daysDone = Math.min(ARTISAN_PLAN_DAYS, daysDone);
  designsDone = Math.min(designCount, designsDone);

  return { calendarDay, daysDone, designsDone, designCount };
}

function statusLabel(status) {
  const map = {
    pending: 'statusPending',
    in_progress: 'statusInProgress',
    done: 'statusDone',
    skipped: 'statusSkipped',
  };
  return creatyT(map[status] || 'statusPending');
}

