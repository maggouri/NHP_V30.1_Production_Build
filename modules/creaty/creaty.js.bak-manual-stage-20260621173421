    acc?.email,
    acc?.display_email,
    acc?.firstName,
    acc?.lastName,
    acc?.status,
    acc?.sessionId,
    acc?.id,
  ].map((value) => String(value || '').toLowerCase()).join(' ');
}

function getImportedAccountKey(email) {
  return String(email || '').trim().toLowerCase();
}

function getVisibleImportedAccounts() {
  const query = String(importedSearchQuery || '').trim().toLowerCase();
  return query
    ? importedSessionsCache.filter((acc) => getImportedAccountSearchText(acc).includes(query))
    : importedSessionsCache.slice();
}

function syncImportedSelectionWithAccounts() {
  const valid = new Set(importedSessionsCache.map((acc) => getImportedAccountKey(acc.email)).filter(Boolean));
  importedSelectedEmails = new Set(Array.from(importedSelectedEmails).filter((email) => valid.has(email)));
}

function updateImportedBulkUi(visibleAccounts = getVisibleImportedAccounts()) {
  syncImportedSelectionWithAccounts();
  const countEl = $('creaty-imported-selected-count');
  if (countEl) countEl.textContent = creatyT('importedSelectedCount', { count: importedSelectedEmails.size });
  const visibleKeys = visibleAccounts.map((acc) => getImportedAccountKey(acc.email)).filter(Boolean);
  const checkedVisible = visibleKeys.filter((email) => importedSelectedEmails.has(email)).length;
  const checkVisible = $('creaty-imported-check-visible');
  if (checkVisible) {
    checkVisible.checked = !!visibleKeys.length && checkedVisible === visibleKeys.length;
    checkVisible.indeterminate = checkedVisible > 0 && checkedVisible < visibleKeys.length;
  }
}

