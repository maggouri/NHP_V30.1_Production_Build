async function copyImportedFieldValue(copyEl) {
  const encodedValue = String(copyEl?.dataset?.copyText || '').trim();
  if (!encodedValue) return;
  const rawValue = decodeURIComponent(encodedValue);
  try {
    await navigator.clipboard.writeText(rawValue);
    importedCopiedFieldKey = String(copyEl.dataset.copyKey || '');
    renderImportedSessionsTable(importedSessionsCache);
    if (importedCopyResetTimer) clearTimeout(importedCopyResetTimer);
    importedCopyResetTimer = setTimeout(() => {
      importedCopiedFieldKey = '';
      importedCopyResetTimer = null;
      renderImportedSessionsTable(importedSessionsCache);
    }, 1400);
  } catch (_err) {
