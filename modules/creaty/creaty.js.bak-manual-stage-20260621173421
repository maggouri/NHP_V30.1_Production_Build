function escapeSupervisorChatHtml(text) {
  return String(text || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

function renderSupervisorMarkdown(text) {
  const raw = String(text || '');
  if (!raw.trim()) return '';

  const codeBlocks = [];
  let working = raw.replace(/```([\s\S]*?)```/g, (_match, code) => {
    const token = `@@CODE${codeBlocks.length}@@`;
    codeBlocks.push(`<pre class="creaty-supervisor-chat-code"><code>${escapeSupervisorChatHtml(code.trim())}</code></pre>`);
    return token;
  });

  working = escapeSupervisorChatHtml(working);
  codeBlocks.forEach((html, index) => {
    working = working.replace(`@@CODE${index}@@`, html);
  });

  working = working.replace(/`([^`\n]+)`/g, '<code class="creaty-supervisor-chat-inline-code">$1</code>');
  working = working.replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>');
  working = working.replace(/(^|[^*])\*([^*\n]+)\*(?!\*)/g, '$1<em>$2</em>');

  const lines = working.split('\n');
  const chunks = [];
  let listItems = [];

  const flushList = () => {
    if (!listItems.length) return;
    chunks.push(`<ul class="creaty-supervisor-chat-list">${listItems.join('')}</ul>`);
    listItems = [];
  };

  for (const line of lines) {
    const bullet = line.match(/^\s*[-*•]\s+(.+)$/);
    if (bullet) {
      listItems.push(`<li>${bullet[1]}</li>`);
      continue;
    }
    flushList();
    if (line.trim()) {
      chunks.push(`<p class="creaty-supervisor-chat-para">${line}</p>`);
    } else {
      chunks.push('<br>');
    }
  }
  flushList();
  return chunks.join('');
}

const SUPERVISOR_CHAT_COPY_ICON = '<i class="fa-solid fa-copy" aria-hidden="true"></i>';
const SUPERVISOR_CHAT_COPIED_ICON = '<i class="fa-solid fa-check" aria-hidden="true"></i>';

function wireChatBubbleCopyButton(bubble, plainText) {
  const text = String(plainText || '').trim();
  if (!text || !bubble) return;

  bubble.dataset.copyText = text;
  bubble.classList.add('creaty-supervisor-chat-bubble--copyable');

  const copyBtn = document.createElement('button');
  copyBtn.type = 'button';
  copyBtn.className = 'creaty-supervisor-chat-copy-btn';
  copyBtn.setAttribute('data-creaty-i18n-title', 'supervisorChatCopy');
  copyBtn.title = creatyT('supervisorChatCopy');
  copyBtn.setAttribute('aria-label', creatyT('supervisorChatCopy'));
  copyBtn.innerHTML = SUPERVISOR_CHAT_COPY_ICON;

  let resetTimer = null;
  copyBtn.addEventListener('click', async (event) => {
    event.preventDefault();
    event.stopPropagation();

    const toCopy = String(
      bubble.dataset.copyText
      || bubble.querySelector('.creaty-supervisor-chat-bubble__text')?.textContent
      || ''
    ).trim();
    if (!toCopy) return;

    try {
      await navigator.clipboard.writeText(toCopy);
      copyBtn.innerHTML = SUPERVISOR_CHAT_COPIED_ICON;
      copyBtn.classList.add('creaty-supervisor-chat-copy-btn--success');
      copyBtn.title = creatyT('supervisorChatCopied');
      if (resetTimer) clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        copyBtn.innerHTML = SUPERVISOR_CHAT_COPY_ICON;
        copyBtn.classList.remove('creaty-supervisor-chat-copy-btn--success');
        copyBtn.title = creatyT('supervisorChatCopy');
        resetTimer = null;
      }, 1500);
    } catch (_err) {
      copyBtn.title = creatyT('supervisorChatCopyFailed');
      creatyHelpers.showToast?.(creatyT('supervisorChatCopyFailed'));
    }
  });

  bubble.appendChild(copyBtn);
}

function appendChatBubble(role, text = '', imageUrl = '', options = {}) {
  const historyEl = $('creaty-supervisor-chat-history');
  if (!historyEl) return null;

  const bubble = document.createElement('div');
  bubble.className = 'creaty-supervisor-chat-bubble';
  if (role === 'user') bubble.classList.add('creaty-supervisor-chat-bubble--user');
  else if (role === 'loading') bubble.classList.add('creaty-supervisor-chat-bubble--ai', 'creaty-supervisor-chat-bubble--loading');
  else if (role === 'system') bubble.classList.add('creaty-supervisor-chat-bubble--ai', 'creaty-supervisor-chat-bubble--system');
  else bubble.classList.add('creaty-supervisor-chat-bubble--ai');

  if (options.id) bubble.id = options.id;

  const textValue = String(text || '').trim();
  if (textValue) {
    const textNode = document.createElement('div');
    textNode.className = 'creaty-supervisor-chat-bubble__text';
    textNode.setAttribute('dir', 'auto');
    if (options.plainText) {
      textNode.textContent = textValue;
    } else {
      textNode.innerHTML = renderSupervisorMarkdown(textValue);
    }
    bubble.appendChild(textNode);
  }

  if (imageUrl) {
    const img = document.createElement('img');
    img.className = 'creaty-supervisor-chat-bubble__img';
    img.src = imageUrl;
    img.alt = creatyT('supervisorChatImageNote');
    bubble.appendChild(img);
  }

  const pendingTools = Array.isArray(options.pendingToolCalls) ? options.pendingToolCalls : [];
  if (pendingTools.length && role === 'ai') {
    supervisorLastPendingToolCalls = pendingTools;
    bubble.dataset.pendingTools = JSON.stringify(pendingTools);
    const fixBtn = document.createElement('button');
    fixBtn.type = 'button';
    fixBtn.className = 'creaty-supervisor-chat-fix-btn';
    fixBtn.textContent = creatyT('supervisorChatFixInternal');
    fixBtn.addEventListener('click', () => {
      void executeSupervisorPendingTools(pendingTools, fixBtn);
    });
    bubble.appendChild(fixBtn);
  }

  if ((role === 'ai' || role === 'system') && textValue) {
    wireChatBubbleCopyButton(bubble, textValue);
  }

  historyEl.appendChild(bubble);
  historyEl.scrollTop = historyEl.scrollHeight;
  return bubble;
}

