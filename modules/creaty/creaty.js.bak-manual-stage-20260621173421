function buildCompliantSignupPassword(rawPassword = '') {
  const original = String(rawPassword || '').trim();
  if (original.length >= 8) return original;
  const suffix = 'Aa1!';
  let next = original;
  while (next.length < 10) next += suffix;
  return next;
}

async function ensureImportedAccountPassword(email, account = {}) {
  const targetEmail = String(email || account.email || account.display_email || '').trim().toLowerCase();
  const original = String(account.password || account.pass || account.secret || '').trim();
  const password = buildCompliantSignupPassword(original);
  if (!targetEmail || password === original) return password;

  const stored = await readStorage(AUT_STORAGE_KEYS);
  const patch = {};
  for (const key of AUT_STORAGE_KEYS) {
    const list = Array.isArray(stored[key]) ? stored[key] : null;
    if (!list) continue;
    let changed = false;
    const nextList = list.map((item) => {
      const itemEmail = String(item?.email || item?.display_email || '').trim().toLowerCase();
      if (itemEmail !== targetEmail) return item;
      changed = true;
      return { ...item, password, pass: password };
    });
    if (changed) patch[key] = nextList;
  }
  if (Object.keys(patch).length) await writeStorage(patch);

  importedSessionsCache = importedSessionsCache.map((item) => (
    String(item?.email || item?.display_email || '').trim().toLowerCase() === targetEmail
      ? { ...item, password, pass: password }
      : item
  ));
  appendLogLine('Password strengthened and saved for ' + targetEmail + ' (' + password.length + ' chars)', 'info');
  return password;
}

