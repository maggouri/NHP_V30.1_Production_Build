    executeNow: options.executeNow === true,
    mode: options.mode || '',
    sanitized: options.sanitized === true,
    forceTool: options.forceTool || '',
  });
  return result || { success: false, error: 'no_response' };
}

async function buildInternalFixContext() {
  const [storage, state] = await Promise.all([
    readStorage([SUPERVISOR_STATUS_KEY, SUPERVISOR_JOURNAL_KEY]),
    sendCreatyAction('CREATY_GET_STATE'),
  ]);
  const status = storage[SUPERVISOR_STATUS_KEY] || {};
  const journal = Array.isArray(storage[SUPERVISOR_JOURNAL_KEY]) ? storage[SUPERVISOR_JOURNAL_KEY] : [];
  const lastFail = journal.find((row) => row && row.success === false) || journal[0] || null;
  const parts = ['Apply E2E form integration fix for detected selector or DOM failure.'];
  if (status.message) parts.push(`Status: ${status.message}`);
  if (status.phase) parts.push(`Phase: ${status.phase}`);
  if (state?.phase) parts.push(`Runner phase: ${state.phase}`);
  const errLog = (state?.logs || []).find((entry) => entry && entry.level === 'error');
  if (errLog?.message) parts.push(`Last error: ${errLog.message}`);
  if (lastFail) {
    const step = lastFail.fieldLabel || lastFail.step || lastFail.action || 'failed step';
    parts.push(`Journal: ${step}`);
  }
  return parts.join('\n');
}

async function requestInternalFixFromSupervisor(triggerBtn = null) {
  if (triggerBtn) {
    triggerBtn.disabled = true;
    triggerBtn.textContent = creatyT('supervisorChatExecuting');
  }
  setSupervisorChatInputEnabled(false);

  const loadingBubble = appendChatBubble('loading', creatyT('supervisorChatExecuting'));
  try {
    const context = await buildInternalFixContext();
    const result = await requestSupervisorChatReply(context, '', {
      executeNow: true,
      mode: 'internal_fix',
      sanitized: true,
      forceTool: 'execute_dom_patch',
    });
    loadingBubble?.remove();
    if (result.success) {
      handleSupervisorChatResult(result);
      return;
    }
    appendChatBubble('ai', creatyT('supervisorChatFailed', {
      error: formatCreatyActionError(result.error || 'no_tool_calls'),
    }), '', { plainText: false });
  } catch (err) {
    loadingBubble?.remove();
    appendChatBubble('ai', creatyT('supervisorChatFailed', {
      error: formatCreatyActionError(err?.message || err),
    }));
  } finally {
    setSupervisorChatInputEnabled(true);
    if (triggerBtn && triggerBtn.isConnected) {
      triggerBtn.disabled = false;
      triggerBtn.textContent = creatyT('supervisorChatFixInternal');
    }
  }
}

async function executeSupervisorPendingTools(toolCalls, triggerBtn = null) {
  const calls = Array.isArray(toolCalls) && toolCalls.length
    ? toolCalls
    : supervisorLastPendingToolCalls;
  if (!calls?.length) {
    await requestInternalFixFromSupervisor(triggerBtn);
    return;
  }

  if (triggerBtn) {
    triggerBtn.disabled = true;
    triggerBtn.textContent = creatyT('supervisorChatExecuting');
  }
  setSupervisorChatInputEnabled(false);

  const loadingBubble = appendChatBubble('loading', creatyT('supervisorChatExecuting'));

  try {
    const result = await sendCreatyAction('CREATY_SUPERVISOR_EXECUTE', { toolCalls: calls });
    loadingBubble?.remove();

    if (result.success) {
      const detail = String(result.text || '').trim() || creatyT('supervisorChatToolSuccess');
      appendChatBubble('system', detail, '', { plainText: false });
      supervisorLastPendingToolCalls = [];
      setSupervisorGlobalFixButtonVisible(false);
      if (triggerBtn) triggerBtn.remove();
      return;
    }

    appendChatBubble('ai', creatyT('supervisorChatToolFailed', {
      error: formatCreatyActionError(result.error || 'unknown'),
    }));
  } catch (err) {
    loadingBubble?.remove();
    appendChatBubble('ai', creatyT('supervisorChatToolFailed', {
      error: formatCreatyActionError(err?.message || err),
    }));
  } finally {
    setSupervisorChatInputEnabled(true);
    if (triggerBtn && triggerBtn.isConnected) {
      triggerBtn.disabled = false;
      triggerBtn.textContent = creatyT('supervisorChatFixInternal');
    }
  }
}

function setSupervisorGlobalFixButtonVisible(visible) {
  const globalFixBtn = $('creaty-supervisor-chat-fix');
  if (!globalFixBtn) return;
  globalFixBtn.hidden = !visible;
}

function handleSupervisorChatResult(result, message = '', hasImage = false) {
  const toolCalls = Array.isArray(result.toolCalls) ? result.toolCalls : [];

  if (result.executed && result.execution) {
    const execText = String(result.text || '').trim()
      || (result.execution.results || []).map((r) => r.message || r.error).filter(Boolean).join('\n')
      || (result.fallback ? creatyT('supervisorChatFallbackFix') : creatyT('supervisorChatToolSuccess'));
    appendChatBubble(result.fallback ? 'system' : 'ai', execText, '', { plainText: false });
    supervisorLastPendingToolCalls = [];
    setSupervisorGlobalFixButtonVisible(false);
    return;
  }

  const replyText = String(result.text || '').trim()
    || (toolCalls.length ? creatyT('supervisorChatFixReady') : buildSupervisorStubReply(message, hasImage));

  appendChatBubble('ai', replyText, '', {
    plainText: false,
    pendingToolCalls: toolCalls.length ? toolCalls : undefined,
  });
  setSupervisorGlobalFixButtonVisible(toolCalls.length > 0);

  if (result.stub && result.error === 'no_api_key') {
    appendChatBubble('ai', creatyT('supervisorChatNoApiKey'));
  }
}

function buildSupervisorStubReply(message, hasImage) {
  const parts = [creatyT('supervisorChatStub')];
  if (message) parts.push(creatyT('supervisorChatEcho', { text: message }));
  if (hasImage) parts.push(creatyT('supervisorChatImageNote'));
  parts.push('\n↪ hook: CREATY_SUPERVISOR_CHAT → NhpAiCliproxy.callNhpAiChat');
  return parts.join('\n');
}

async function sendSupervisorChatMessage() {
  if (supervisorChatSending) return;

  const textarea = $('creaty-supervisor-chat-text');
  const message = String(textarea?.value || '').trim();
  const imageDataUrl = supervisorChatPendingImage || '';

  if (!message && !imageDataUrl) {
    appendChatBubble('ai', creatyT('supervisorChatEmpty'));
    return;
  }

  supervisorChatSending = true;
  setSupervisorChatInputEnabled(false);

  appendChatBubble('user', message, imageDataUrl);
  if (textarea) {
    textarea.value = '';
    resizeSupervisorChatTextarea();
  }
  clearSupervisorChatAttachment();

  const loadingBubble = appendChatBubble('loading', creatyT('supervisorChatThinking'));

  try {
    const result = await requestSupervisorChatReply(message, imageDataUrl);
    loadingBubble?.remove();

    if (result.success) {
      handleSupervisorChatResult(result, message, !!imageDataUrl);
      return;
    }

    appendChatBubble('ai', creatyT('supervisorChatFailed', {
      error: formatCreatyActionError(result.error || 'unknown'),
    }));
  } catch (err) {
    loadingBubble?.remove();
    appendChatBubble('ai', creatyT('supervisorChatFailed', {
      error: formatCreatyActionError(err?.message || err),
    }));
  } finally {
    supervisorChatSending = false;
    setSupervisorChatInputEnabled(true);
    textarea?.focus();
  }
}

function initSupervisorChat() {
  if (supervisorChatWired) return;
  supervisorChatWired = true;

  const historyEl = $('creaty-supervisor-chat-history');
  const form = $('creaty-supervisor-chat-form');
  const textarea = $('creaty-supervisor-chat-text');
  const attachBtn = $('creaty-supervisor-chat-attach');
  const fileInput = $('creaty-supervisor-chat-file');
  const clearBtn = $('creaty-supervisor-chat-attach-clear');

  if (!historyEl || !form || !textarea) return;

  clearSupervisorChatAttachment();

  if (!historyEl.childElementCount) {
    appendChatBubble('ai', creatyT('supervisorChatWelcome'));
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    void sendSupervisorChatMessage();
  });

  textarea.addEventListener('input', resizeSupervisorChatTextarea);
  textarea.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' && !event.shiftKey) {
      event.preventDefault();
      void sendSupervisorChatMessage();
    }
  });

  attachBtn?.addEventListener('click', () => fileInput?.click());

  fileInput?.addEventListener('change', () => {
    attachSupervisorChatImageFile(fileInput.files?.[0]);
  });

  textarea.addEventListener('paste', (event) => {
    const items = event.clipboardData?.items;
    if (!items?.length) return;

    for (let i = 0; i < items.length; i += 1) {
      const item = items[i];
      if (item.type.indexOf('image') !== 0) continue;
      const file = item.getAsFile();
      if (!file) continue;
      event.preventDefault();
      attachSupervisorChatImageFile(file);
      return;
    }
  });

  clearBtn?.addEventListener('click', (event) => {
    event.preventDefault();
    event.stopPropagation();
    clearSupervisorChatAttachment();
  });

  const globalFixBtn = $('creaty-supervisor-chat-fix');
  globalFixBtn?.addEventListener('click', () => {
    void executeSupervisorPendingTools(supervisorLastPendingToolCalls, globalFixBtn);
  });

  resizeSupervisorChatTextarea();
}

