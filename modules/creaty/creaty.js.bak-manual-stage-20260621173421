async function enrichDashRowsWithDesignNames(rows) {
  try {
    const { listDesignGroups } = await import('./design-library.js');
    const groups = await listDesignGroups();
    const byAccount = new Map();
    for (const group of groups) {
      const acc = String(group.assignedAccountId || '').trim().toLowerCase();
      if (!acc) continue;
      if (!byAccount.has(acc)) byAccount.set(acc, []);
      for (const design of group.designs || []) {
        const label = String(design.title || design.filename || '').trim();
        if (label) byAccount.get(acc).push(label);
      }
    }
    return rows.map((row) => {
      const fromLib = byAccount.get(String(row.email || '').trim().toLowerCase()) || [];
      const merged = row.designNames?.length ? row.designNames : fromLib;
      return { ...row, designNames: merged };
    });
  } catch (_) {
    return rows;
  }
}

