  const skipBtn = $('creaty-schedule-skip');
  const completeBtn = $('creaty-schedule-complete');
  const startBtn = $('creaty-schedule-start-btn');

  const paused = !!scheduleState?.paused;
  const isStarted = !!started;

  if (startBtn) startBtn.disabled = isStarted && !paused;
  if (pauseBtn) pauseBtn.disabled = !isStarted || paused;
  if (resumeBtn) resumeBtn.disabled = !isStarted || !paused;
  if (resetBtn) resetBtn.disabled = !scheduleState;
  if (skipBtn) skipBtn.disabled = !isStarted || paused;
  if (completeBtn) completeBtn.disabled = !isStarted;
}

function renderScheduleProgress() {
  const dayEl = $('creaty-schedule-day-progress');
  const designEl = $('creaty-schedule-design-progress');
  const fillEl = $('creaty-schedule-progress-fill');
  const pillEl = $('creaty-schedule-status-pill');
  const bar = fillEl?.parentElement;

  if (!scheduleState) {
    if (dayEl) dayEl.textContent = creatyT('scheduleDaysProgress', { done: 0, total: ARTISAN_PLAN_DAYS });
    if (designEl) designEl.textContent = creatyT('scheduleDesignsProgress', { done: 0, total: ARTISAN_MAX_DESIGNS });
    if (fillEl) fillEl.style.width = '0%';
    if (pillEl) {
      pillEl.textContent = creatyT('scheduleNotStarted');
      pillEl.className = 'creaty-schedule-pill creaty-schedule-pill--idle';
    }
    if (bar) bar.setAttribute('aria-valuenow', '0');
    return;
  }

  const { daysDone, designsDone, designCount } = countProgress(scheduleState);
  const pct = Math.round((daysDone / ARTISAN_PLAN_DAYS) * 100);

  if (dayEl) dayEl.textContent = creatyT('scheduleDaysProgress', { done: daysDone, total: ARTISAN_PLAN_DAYS });
  if (designEl) designEl.textContent = creatyT('scheduleDesignsProgress', { done: designsDone, total: designCount });
  if (fillEl) fillEl.style.width = `${pct}%`;
  if (bar) {
    bar.setAttribute('aria-valuenow', String(pct));
    bar.setAttribute('aria-valuemax', '100');
  }

  if (pillEl) {
    if (!scheduleState.started) {
      pillEl.textContent = creatyT('scheduleNotStarted');
      pillEl.className = 'creaty-schedule-pill creaty-schedule-pill--idle';
    } else if (scheduleState.paused) {
      pillEl.textContent = creatyT('schedulePaused');
      pillEl.className = 'creaty-schedule-pill creaty-schedule-pill--paused';
    } else if (daysDone >= ARTISAN_PLAN_DAYS) {
      pillEl.textContent = creatyT('scheduleComplete');
      pillEl.className = 'creaty-schedule-pill creaty-schedule-pill--done';
    } else if (scheduleState.automationEnabled && scheduleState.started && !scheduleState.paused) {
      pillEl.textContent = creatyT('scheduleActive');
      pillEl.className = 'creaty-schedule-pill creaty-schedule-pill--active';
    } else {
      pillEl.textContent = creatyT('scheduleActive');
      pillEl.className = 'creaty-schedule-pill creaty-schedule-pill--active';
    }
  }
}

function renderTimeline() {
  const el = $('creaty-timeline');
  if (!el) return;

  const schedule = scheduleState;
  const calendarDay = schedule ? calendarDayFromSchedule(schedule) : 1;
  const designCount = Math.min(ARTISAN_MAX_DESIGNS, Number(schedule?.designCount) || ARTISAN_MAX_DESIGNS);
  const designPhases = ARTISAN_PHASE_DEFS.filter((d) => d.isDesign);
  const allowedDesignIds = new Set(designPhases.slice(0, designCount).map((d) => d.id));

  const phasesToShow = ARTISAN_PHASE_DEFS.filter((def) => !def.isDesign || allowedDesignIds.has(def.id));

  el.innerHTML = phasesToShow.map((def) => {
    const stored = schedule?.phases?.find((p) => p.id === def.id);
    const status = schedule?.started
      ? effectivePhaseStatus(def, schedule, calendarDay)
      : (stored?.status || 'pending');
    const isCurrent = schedule?.started && calendarDay >= def.dayStart && calendarDay <= def.dayEnd
      && status !== 'done' && status !== 'skipped';

    const checklistHtml = def.checklistKeys.map((chkKey) => {
      const checked = !!stored?.checklist?.[chkKey];
      const disabled = !schedule?.started;
      return `<label class="creaty-checklist-item">
        <input type="checkbox" data-phase-id="${def.id}" data-chk-key="${chkKey}" ${checked ? 'checked' : ''} ${disabled ? 'disabled' : ''}>
        <span>${creatyT(chkKey)}</span>
      </label>`;
    }).join('');

    return `<article class="creaty-phase-card creaty-phase-card--${status}${isCurrent ? ' creaty-phase-card--current' : ''}" data-phase-id="${def.id}">
      <header class="creaty-phase-card__head">
        <div class="creaty-phase-card__meta">
          <span class="creaty-phase-card__days">${creatyT('dayRange', { start: def.dayStart, end: def.dayEnd })}</span>
          <span class="creaty-phase-card__status creaty-phase-card__status--${status}">${statusLabel(status)}</span>
        </div>
        <h3 class="creaty-phase-card__title">${creatyT(def.titleKey)}</h3>
        <p class="creaty-phase-card__actions">${creatyT(def.actionsKey)}</p>
      </header>
      <details class="creaty-phase-card__checklist" ${isCurrent ? 'open' : ''}>
        <summary>${creatyT('scheduleChecklist')}</summary>
        <div class="creaty-checklist">${checklistHtml}</div>
      </details>
    </article>`;
  }).join('');

  el.querySelectorAll('.creaty-checklist input[type="checkbox"]').forEach((input) => {
    input.addEventListener('change', async () => {
      if (!scheduleState) return;
      const phaseId = input.getAttribute('data-phase-id');
      const chkKey = input.getAttribute('data-chk-key');
      const phase = scheduleState.phases.find((p) => p.id === phaseId);
      if (!phase) return;
      if (!phase.checklist) phase.checklist = {};
      phase.checklist[chkKey] = input.checked;
      await saveSchedule(scheduleState.accountEmail, scheduleState);
    });
  });

  lastRenderedCalendarDay = calendarDay;
}

