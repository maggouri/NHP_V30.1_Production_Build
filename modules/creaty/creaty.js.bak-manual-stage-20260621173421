  }
}

async function checkCreatyServerStatusNow() {
  if (creatyServerCheckInFlight) return creatyServerCheckInFlight;

  creatyServerCheckInFlight = (async () => {
    try {
      const pingRes = await fetchCreatyWithTimeout(`${CREATY_SERVER_BASE}/ping`, {}, 3000);
      if (!pingRes.ok) {
        setCreatyServerStatusUi(false, 'ping-failed');
        return;
      }
      let serverPhase = 'IDLE';
      let queueMeta = {};
      try {
        const statusRes = await fetchCreatyWithTimeout(`${CREATY_SERVER_BASE}/status`, {}, 2500);
        if (statusRes.ok) {
          const statusData = await statusRes.json();
          serverPhase = String(statusData.phase || statusData.status || 'IDLE').toUpperCase();
          queueMeta = {
            queueLength: statusData.queueLength || (Array.isArray(statusData.queue) ? statusData.queue.length : 0),
            currentEmail: statusData.currentEmail || statusData.email || '',
          };
        }
      } catch (_) { /* optional */ }
      setCreatyServerStatusUi(true, 'direct-ping', serverPhase, queueMeta);
    } catch (_) {
      setCreatyServerStatusUi(false, 'offline');
    }
  })();

  try {
    return await creatyServerCheckInFlight;
  } finally {
    creatyServerCheckInFlight = null;
  }
}

async function wakeCreatyServerFromColumn() {
  if (creatyServerWakePending) return;
  creatyServerWakePending = true;
  const wakeBtn = $('creaty-server-wake-btn');
  if (wakeBtn) wakeBtn.disabled = true;
  appendLogLine(creatyT('serverWaking'), 'info');

  try {
    const wakeResult = await sendCreatyAction('wake_creaty_server', { port: CREATY_SERVER_PORT });
    if (wakeResult?.success === false && !wakeResult?.pending) {
      setCreatyServerStatusUi(false, 'wake-failed');
      appendLogLine(wakeResult?.error || creatyT('serverWakeFail'), 'error');
      return;
    }

    for (let attempt = 1; attempt <= 4; attempt += 1) {
      await new Promise((r) => setTimeout(r, 2500));
      try {
        const res = await fetchCreatyWithTimeout(`${CREATY_SERVER_BASE}/ping`, {}, 3000);
        if (res.ok) {
          await checkCreatyServerStatusNow();
          appendLogLine(creatyT('serverWakeOk'), 'success');
          return;
        }
      } catch (_) { /* retry */ }
    }
    setCreatyServerStatusUi(false, 'wake-failed');
  } finally {
    creatyServerWakePending = false;
    const btn = $('creaty-server-wake-btn');
    if (btn) btn.disabled = false;
    void checkCreatyServerStatusNow();
  }
}

function startCreatyServerMonitor() {
  if (creatyServerPollTimer) return;
  void checkCreatyServerStatusNow();
  creatyServerPollTimer = setInterval(() => {
    const panel = document.getElementById('panel-creaty');
    const isActive = !!(panel && panel.classList.contains('active'));
    if (!isActive && !creatyServerWakePending) return;
