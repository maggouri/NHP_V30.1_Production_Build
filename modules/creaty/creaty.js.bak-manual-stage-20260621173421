    return `<span class="creaty-queue-badge creaty-queue-badge--cloudflare" title="${creatyT('cloudflareWaitLog')}">${creatyT('phaseCloudflareWait')}</span>`;
  }
  if (key === 'SKIPPED') {
    const title = skipReason ? ` title="${String(skipReason).replace(/"/g, '&quot;')}"` : '';
    return `<span class="creaty-queue-badge creaty-queue-badge--skipped"${title}>${creatyT('phaseSkipped')}</span>`;
  }
  if (key === 'QUEUED') {
    return `<span class="creaty-queue-badge creaty-queue-badge--queued">${creatyT('phaseQueued')}</span>`;
  }
  return `<span class="creaty-queue-badge creaty-queue-badge--phase">${key}</span>`;
}

function renderQueuePreview(queue) {
  const el = $('creaty-queue-preview');
  const countEl = $('creaty-queue-count');
  if (!el) return;
  const list = Array.isArray(queue) ? queue : [];
  if (countEl) countEl.textContent = creatyT('queueCount', { n: list.length });
  if (!list.length) {
    el.innerHTML = `<div class="creaty-queue-row"><span>${creatyT('queueEmpty')}</span></div>`;
    return;
  }
  el.innerHTML = list
    .slice(0, 8)
    .map((item) => {
      const email = item.display_email || item.email || '';
      const emailEnc = encodeURIComponent(email);
      const phase = item.creaty_phase || 'PENDING';
      const skipReason = item.skipReason || '';
      const phaseKey = String(phase).toUpperCase();
      const canSkip = phaseKey !== 'SKIPPED' && phaseKey !== 'DONE';
      const skipBtn = canSkip
        ? `<button type="button" class="creaty-icon-btn creaty-queue-skip-btn" data-email="${emailEnc}" title="${creatyT('queueSkip')}" aria-label="${creatyT('queueSkip')}"><i class="fa-solid fa-forward-step" aria-hidden="true"></i></button>`
        : '';
      return `<div class="creaty-queue-row" data-email="${emailEnc}">
        <span class="creaty-queue-email" dir="ltr">${escapeCreatyHtml(email)}</span>
        <div class="creaty-queue-row-meta">
          ${renderPhaseBadge(phase, skipReason)}
          <div class="creaty-queue-row-actions">
            ${skipBtn}
            <button type="button" class="creaty-icon-btn creaty-queue-delete-btn" data-email="${emailEnc}" title="${creatyT('queueDelete')}" aria-label="${creatyT('queueDelete')}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
          </div>
        </div>
      </div>`;
    })
    .join('');
}

