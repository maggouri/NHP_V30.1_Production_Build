function applyStoreGeneratedImages(imageResult) {
  if (!imageResult) return;
  if (imageResult.avatarDataUrl) {
    storeAvatarDataUrl = imageResult.avatarDataUrl;
    renderStoreImagePreview('avatar', storeAvatarDataUrl);
  }
  if (imageResult.coverDataUrl) {
    storeCoverDataUrl = imageResult.coverDataUrl;
    renderStoreImagePreview('cover', storeCoverDataUrl);
  }
  if (storeProfileDraft) {
    storeProfileDraft = {
      ...storeProfileDraft,
      avatarDataUrl: storeAvatarDataUrl || storeProfileDraft.avatarDataUrl || null,
      coverDataUrl: storeCoverDataUrl || storeProfileDraft.coverDataUrl || null,
      avatarRef: storeAvatarDataUrl ? 'inline_avatar' : storeProfileDraft.avatarRef,
      coverRef: storeCoverDataUrl ? 'inline_cover' : storeProfileDraft.coverRef,
    };
  }
}

async function runStoreImageGeneration(email, profile, { statusPrefix = '' } = {}) {
  const prefix = statusPrefix ? `${statusPrefix} — ` : '';
  setStoreStatus(`${prefix}${creatyT('storeGeneratingImages')}`, 'busy');
  const imageResult = await sendCreatyAction('CREATY_GENERATE_STORE_IMAGES', {
    accountEmail: email,
    profile,
    niche: profile?.niche || $('creaty-store-niche')?.value?.trim() || '',
  });
  if (!imageResult?.success) {
    const errKey = imageResult?.error === 'store_no_api_key'
      ? creatyT('storeNoApiKey')
      : creatyT('storeGenerateFailed', { error: imageResult?.error || '?' });
    setStoreStatus(errKey, 'err');
    return { success: false, error: imageResult?.error };
  }
  applyStoreGeneratedImages(imageResult);
  if ($('creaty-store-save-btn')) $('creaty-store-save-btn').disabled = false;
  if (imageResult.partial) {
    const partialErr = imageResult.errors?.map((e) => `${e.type}: ${e.error}`).join('; ') || '?';
    setStoreStatus(creatyT('storeImagesPartial', { error: partialErr }), 'ok');
  } else {
    setStoreStatus(creatyT('storeImagesGenerated'), 'ok');
  }
  appendLogLine(creatyT('storeImagesGenerated'), 'success');
  return { success: true, result: imageResult };
}

function fillStoreOutputFromProfile(profile) {
  const output = $('creaty-store-output');
  if (output) output.hidden = false;
  if ($('creaty-store-title')) $('creaty-store-title').value = profile?.title || '';
  if ($('creaty-store-bio')) $('creaty-store-bio').value = profile?.bio || '';
  const links = profile?.links || {};
  if ($('creaty-store-link-ig')) $('creaty-store-link-ig').value = links.instagram || '';
  if ($('creaty-store-link-tw')) $('creaty-store-link-tw').value = links.twitter || '';
  if ($('creaty-store-link-fb')) $('creaty-store-link-fb').value = links.facebook || '';
  if ($('creaty-store-link-pin')) $('creaty-store-link-pin').value = links.pinterest || '';
  const prompts = profile?.imagePrompts || {};
  if ($('creaty-store-avatar-prompt')) $('creaty-store-avatar-prompt').value = prompts.avatar || '';
  if ($('creaty-store-cover-prompt')) $('creaty-store-cover-prompt').value = prompts.cover || '';
  if (profile?.avatarDataUrl) {
    storeAvatarDataUrl = profile.avatarDataUrl;
    renderStoreImagePreview('avatar', storeAvatarDataUrl);
  }
  if (profile?.coverDataUrl) {
    storeCoverDataUrl = profile.coverDataUrl;
    renderStoreImagePreview('cover', storeCoverDataUrl);
  }
  if ($('creaty-store-save-btn')) $('creaty-store-save-btn').disabled = !profile?.title;
  setStoreImageButtonsEnabled(!!profile?.title);
  renderCreatyFloatingCard();
}

function readStoreFormProfile() {
  return {
    title: $('creaty-store-title')?.value?.trim() || '',
    bio: $('creaty-store-bio')?.value?.trim() || '',
    niche: $('creaty-store-niche')?.value?.trim() || $('creaty-schedule-niche')?.value?.trim() || '',
    links: {
      instagram: $('creaty-store-link-ig')?.value?.trim() || '',
      twitter: $('creaty-store-link-tw')?.value?.trim() || '',
      facebook: $('creaty-store-link-fb')?.value?.trim() || '',
      pinterest: $('creaty-store-link-pin')?.value?.trim() || '',
    },
    imagePrompts: {
      avatar: $('creaty-store-avatar-prompt')?.value?.trim() || '',
      cover: $('creaty-store-cover-prompt')?.value?.trim() || '',
    },
    avatarRef: storeAvatarDataUrl ? 'inline_avatar' : (storeProfileDraft?.avatarRef || null),
    coverRef: storeCoverDataUrl ? 'inline_cover' : (storeProfileDraft?.coverRef || null),
    avatarDataUrl: storeAvatarDataUrl || storeProfileDraft?.avatarDataUrl || null,
