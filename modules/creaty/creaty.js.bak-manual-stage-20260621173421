async function loadStoreProfileUi() {
  const email = $('creaty-store-account')?.value?.trim();
  if (!email) {
    storeProfileDraft = null;
    storeAvatarDataUrl = null;
    storeCoverDataUrl = null;
    renderStoreImagePreview('avatar', null);
    renderStoreImagePreview('cover', null);
    if ($('creaty-store-output')) $('creaty-store-output').hidden = true;
    setStoreImageButtonsEnabled(false);
    setStoreStatus(creatyT('storeHint'));
    renderCreatyFloatingCard();
    return;
  }
  const res = await sendCreatyAction('CREATY_LOAD_STORE_PROFILE', { accountEmail: email });
  if (res?.profile) {
    storeProfileDraft = res.profile;
    storeAvatarDataUrl = res.profile.avatarDataUrl || null;
    storeCoverDataUrl = res.profile.coverDataUrl || null;
    fillStoreOutputFromProfile(res.profile);
    renderStoreImagePreview('avatar', storeAvatarDataUrl);
    renderStoreImagePreview('cover', storeCoverDataUrl);
    if (res.profile.niche && $('creaty-store-niche')) $('creaty-store-niche').value = res.profile.niche;
    setStoreStatus(creatyT('storeSaved', { email }), 'ok');
  }
  renderCreatyFloatingCard();
}

function wireStoreGeneratorUi() {
  if (storeGenUiWired) return;
  storeGenUiWired = true;

  const binaryRoot = $('creaty-store-binary-tabs-root');
  if (binaryRoot && !storeAssetsBinaryUi) {
    storeAssetsBinaryUi = initStoreAssetsBinary(binaryRoot, {
      initialTarget: 'avatar',
      showToast: (...args) => creatyHelpers.showToast?.(...args),
      getValue(target) {
        return target === 'cover' ? (storeCoverDataUrl || '') : (storeAvatarDataUrl || '');
      },
      async onAssign(target, dataUrl) {
        if (target === 'cover') storeCoverDataUrl = dataUrl;
        else storeAvatarDataUrl = dataUrl;
        renderStoreImagePreview(target, dataUrl);
        if ($('creaty-store-save-btn')) $('creaty-store-save-btn').disabled = false;
      },
    });
  }

  $('creaty-store-account')?.addEventListener('change', () => {
    void loadStoreProfileUi();
  });

  $('creaty-store-generate-btn')?.addEventListener('click', async () => {
    const email = $('creaty-store-account')?.value?.trim();
    const nicheInput = $('creaty-store-niche');
    let niche = nicheInput?.value?.trim() || $('creaty-schedule-niche')?.value?.trim() || '';
    if (!email) {
      setStoreStatus(creatyT('storeAccountRequired'), 'err');
      return;
    }
    const acc = allStoreAccounts.find((a) => a.email === email) || activatedAccounts.find((a) => a.email === email);
    setStoreStatus(creatyT('storeGenerating'), 'busy');
    const btn = $('creaty-store-generate-btn');
    const imagesBtn = $('creaty-store-generate-images-btn');
    if (btn) btn.disabled = true;
    if (imagesBtn) imagesBtn.disabled = true;
    const result = await sendCreatyAction('CREATY_GENERATE_STORE', {
      accountEmail: email,
      niche,
      displayName: acc?.displayName || acc?.storeName || '',
    });
    if (!result?.success) {
      if (btn) btn.disabled = false;
      const errKey = result?.error === 'store_no_api_key' ? creatyT('storeNoApiKey') : creatyT('storeGenerateFailed', { error: result?.error || '?' });
      setStoreStatus(errKey, 'err');
      return;
    }
    storeProfileDraft = result.profile;
    if (result.niche && nicheInput) {
      nicheInput.value = result.niche;
      if ($('creaty-schedule-niche') && !$('creaty-schedule-niche').value.trim()) {
        $('creaty-schedule-niche').value = result.niche;
      }
    }
    fillStoreOutputFromProfile(result.profile);
    const textStatus = result.autoNiche && result.niche
      ? `${creatyT('storeGenerated')} — ${creatyT('storeNicheAutoPicked', { niche: result.niche })}`
      : creatyT('storeGenerated');
    setStoreStatus(textStatus, 'ok');
    appendLogLine(textStatus, 'success');

    const profileForImages = {
      ...result.profile,
      niche: result.niche || niche,
    };
    await runStoreImageGeneration(email, profileForImages, { statusPrefix: textStatus });
    if (btn) btn.disabled = false;
    setStoreImageButtonsEnabled(true);
  });

  $('creaty-store-generate-images-btn')?.addEventListener('click', async () => {
    const email = $('creaty-store-account')?.value?.trim();
    if (!email) {
      setStoreStatus(creatyT('storeAccountRequired'), 'err');
      return;
    }
    const profile = readStoreFormProfile();
    if (!profile.title) {
      setStoreStatus(creatyT('storeNicheRequired'), 'err');
      return;
    }
    const btn = $('creaty-store-generate-images-btn');
    const genBtn = $('creaty-store-generate-btn');
    if (btn) btn.disabled = true;
    if (genBtn) genBtn.disabled = true;
    await runStoreImageGeneration(email, profile);
    if (btn) btn.disabled = false;
    if (genBtn) genBtn.disabled = false;
  });

  $('creaty-store-save-btn')?.addEventListener('click', async () => {
    const email = $('creaty-store-account')?.value?.trim();
    if (!email) {
      setStoreStatus(creatyT('storeAccountRequired'), 'err');
      return;
    }
    const profile = readStoreFormProfile();
    if (!profile.title) {
      setStoreStatus(creatyT('storeNicheRequired'), 'err');
      return;
    }
    const result = await sendCreatyAction('CREATY_SAVE_STORE_PROFILE', { accountEmail: email, profile });
    if (!result?.success) {
      setStoreStatus(creatyT('storeGenerateFailed', { error: result?.error || '?' }), 'err');
      return;
    }
    storeProfileDraft = result.profile;
    setStoreStatus(creatyT('storeSaved', { email }), 'ok');
    appendLogLine(creatyT('storeSaved', { email }), 'success');
    await loadActivatedAccounts();
    await loadAllStoreAccounts();
    renderActivatedAccountSelect();
