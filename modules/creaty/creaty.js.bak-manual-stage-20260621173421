  });

  const startDateInput = $('creaty-schedule-start-date');
  if (startDateInput && !startDateInput.value) startDateInput.value = todayIso();
  updateScheduleSelectionUi();

  $('creaty-schedule-select-mode')?.addEventListener('change', () => {
    updateScheduleSelectionUi();
    const email = $('creaty-schedule-account')?.value?.trim();
    void renderScheduleBundlePreview(email);
  });

  $('creaty-schedule-account')?.addEventListener('change', () => {
    void onScheduleAccountChange();
  });

  $('creaty-schedule-accounts-multi')?.addEventListener('change', () => {
    const selected = Array.from($('creaty-schedule-accounts-multi')?.selectedOptions || []).map((o) => o.value);
    if (selected[0]) void renderScheduleBundlePreview(selected[0]);
  });

  $('creaty-schedule-skip-store')?.addEventListener('change', () => {
    const email = $('creaty-schedule-account')?.value?.trim();
    void renderScheduleBundlePreview(email);
  });

  $('creaty-schedule-start-btn')?.addEventListener('click', async () => {
    const form = readScheduleForm();
    const mode = getScheduleSelectionMode();
    const batchPayload = readScheduleBatchPayload(form);
    const skipStore = $('creaty-schedule-skip-store')?.checked === true;

    if (mode === 'single') {
      if (!form.accountEmail) {
        appendLogLine(creatyT('scheduleAccountRequired'), 'warn');
        return;
      }
      if (!form.niche) {
        const profileRes = await sendCreatyAction('CREATY_LOAD_STORE_PROFILE', { accountEmail: form.accountEmail });
        const nicheFromProfile = profileRes?.profile?.niche || '';
        if (nicheFromProfile) {
          form.niche = nicheFromProfile;
          batchPayload.niche = nicheFromProfile;
          if ($('creaty-schedule-niche')) $('creaty-schedule-niche').value = nicheFromProfile;
        }
      }
      if (!form.niche && !skipStore) {
        appendLogLine(creatyT('scheduleNicheRequired'), 'warn');
        $('creaty-schedule-niche')?.focus();
        return;
      }
    } else if (mode === 'multi' && !batchPayload.accountEmails.length) {
      appendLogLine(creatyT('scheduleAccountRequired'), 'warn');
      return;
    }

    const action = mode === 'single' ? 'CREATY_SCHEDULE_START' : 'CREATY_SCHEDULE_BATCH_START';
    const result = await sendCreatyAction(action, {
      ...batchPayload,
      niche: form.niche || batchPayload.niche || '',
      skipStoreSetup: skipStore,
    });

    if (!result?.success) {
      appendLogLine(mapScheduleError(result?.error) || result?.error || 'Schedule start failed', 'error');
      (result?.skipped || []).forEach((item) => {
        appendLogLine(creatyT('scheduleBatchSkipped', { email: item.email, reason: item.reason }), 'warn');
      });
      return;
    }

    if (mode !== 'single') {
      (result.skipped || []).forEach((item) => {
        appendLogLine(creatyT('scheduleBatchSkipped', { email: item.email, reason: item.reason }), 'warn');
      });
      appendLogLine(creatyT('scheduleBatchStarted', {
        started: result.started || 0,
        total: result.total || 0,
      }), 'success');
      if (result.results?.[0]?.schedule) {
        scheduleState = result.results[0].schedule;
        if ($('creaty-schedule-account') && result.results[0].email) {
          $('creaty-schedule-account').value = result.results[0].email;
        }
      }
    } else {
      scheduleState = result.schedule || scheduleState;
      if (scheduleState) {
        scheduleState.started = true;
        scheduleState.paused = false;
        scheduleState.automationEnabled = true;
        scheduleState.skipStoreSetup = skipStore;
        await saveSchedule(form.accountEmail, scheduleState);
      }
      appendLogLine(creatyT('scheduleStarted', { email: form.accountEmail }), 'success');
    }

    syncScheduleControlsFromState();
    renderScheduleProgress();
    renderTimeline();
    void checkGhostServerStatusNow();
    void renderScheduleBundlePreview(form.accountEmail || batchPayload.accountEmails?.[0]);
  });

  $('creaty-schedule-pause')?.addEventListener('click', async () => {
    const email = scheduleState?.accountEmail || $('creaty-schedule-account')?.value?.trim();
    if (!email) return;
    const result = await sendCreatyAction('CREATY_SCHEDULE_PAUSE', { accountEmail: email });
    if (result?.schedule) scheduleState = result.schedule;
    else if (scheduleState) {
      scheduleState.paused = true;
      await saveSchedule(email, scheduleState);
    }
    syncScheduleControlsFromState();
    renderScheduleProgress();
    renderTimeline();
  });

  $('creaty-schedule-resume')?.addEventListener('click', async () => {
    const email = scheduleState?.accountEmail || $('creaty-schedule-account')?.value?.trim();
    if (!email) return;
    const result = await sendCreatyAction('CREATY_SCHEDULE_RESUME', { accountEmail: email });
    if (result?.schedule) scheduleState = result.schedule;
    else if (scheduleState) {
      scheduleState.paused = false;
      scheduleState.automationEnabled = true;
      scheduleState.currentDay = calendarDayFromSchedule(scheduleState);
      await saveSchedule(email, scheduleState);
    }
    syncScheduleControlsFromState();
    renderScheduleProgress();
    renderTimeline();
    void checkGhostServerStatusNow();
  });

  $('creaty-schedule-reset')?.addEventListener('click', async () => {
    const email = scheduleState?.accountEmail || $('creaty-schedule-account')?.value?.trim();
    if (!email) return;
    await sendCreatyAction('CREATY_SCHEDULE_RESET', { accountEmail: email });
    const key = scheduleStorageKey(email);
    await new Promise((resolve) => chrome.storage.local.remove(key, resolve));
    scheduleState = createDefaultSchedule({
      accountEmail: email,
      niche: '',
      startDate: todayIso(),
      daysBetween: 2,
      designCount: ARTISAN_MAX_DESIGNS,
    });
    $('creaty-schedule-niche').value = '';
    $('creaty-schedule-start-date').value = todayIso();
    $('creaty-schedule-gap').value = '2';
    $('creaty-schedule-designs').value = String(ARTISAN_MAX_DESIGNS);
    if ($('creaty-schedule-skip-store')) $('creaty-schedule-skip-store').checked = false;
    syncScheduleControlsFromState();
    renderScheduleProgress();
    renderTimeline();
    renderNextUploadLabel();
    appendLogLine(creatyT('scheduleResetDone'), 'warn');
  });

  $('creaty-schedule-skip')?.addEventListener('click', async () => {
    if (!scheduleState?.started || scheduleState.paused) return;
    const nextDay = Math.min(ARTISAN_PLAN_DAYS, (scheduleState.currentDay || 1) + 1);
    scheduleState.currentDay = nextDay;
    await saveSchedule(scheduleState.accountEmail, scheduleState);
    renderScheduleProgress();
    renderTimeline();
  });

  $('creaty-schedule-complete')?.addEventListener('click', async () => {
    if (!scheduleState?.started) return;
    const calendarDay = calendarDayFromSchedule(scheduleState);
    const def = phaseForDay(calendarDay, scheduleState);
    if (!def) return;
    const phase = scheduleState.phases.find((p) => p.id === def.id);
    if (!phase) return;
    phase.status = 'done';
    if (def.checklistKeys) {
      def.checklistKeys.forEach((k) => { phase.checklist[k] = true; });
    }
    if (calendarDay < def.dayEnd) {
      scheduleState.currentDay = def.dayEnd + 1;
    } else {
      scheduleState.currentDay = Math.min(ARTISAN_PLAN_DAYS, calendarDay + 1);
    }
    await saveSchedule(scheduleState.accountEmail, scheduleState);
    renderScheduleProgress();
    renderTimeline();
  });

  ['creaty-schedule-niche', 'creaty-schedule-start-date', 'creaty-schedule-gap', 'creaty-schedule-designs'].forEach((id) => {
    $(id)?.addEventListener('change', async () => {
      if (!scheduleState) return;
      const form = readScheduleForm();
      if (!scheduleState.started) {
        scheduleState.niche = form.niche;
        scheduleState.startDate = form.startDate;
        scheduleState.daysBetween = form.daysBetween;
        scheduleState.designCount = form.designCount;
        await saveSchedule(scheduleState.accountEmail, scheduleState);
      }
    });
  });

  chrome.storage.onChanged.addListener((changes, area) => {
    if (area !== 'local') return;
    if (changes.ap_accounts_teepublic || changes.ap_accounts) {
      void refreshScheduleUi();
    }
  });
}

function appendLogLine(text, level = 'info') {
  const log = $('creaty-log');
  if (!log) return;
  const normalizedLevel = normalizeCreatyLogLevel(text, level);
  const line = document.createElement('div');
  line.className = `creaty-log-line creaty-log-line--${normalizedLevel}`;
  const ts = new Date().toLocaleTimeString();
  line.textContent = `[${ts}] ${text}`;
  log.prepend(line);
  while (log.children.length > 120) {
    log.removeChild(log.lastChild);
  }
}

function escapeCreatyHtml(text) {
  return String(text || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

function normalizeImportedSessionAccount(acc = {}) {
  const email = String(acc.email || acc.display_email || '').trim();
  const displayName = String(acc.displayName || acc.display_name || acc.name || '').trim();
  const firstName = String(acc.firstName || acc.first_name || acc.firstname || '').trim();
  const lastName = String(acc.lastName || acc.last_name || acc.lastname || '').trim();
  const parts = displayName.split(/\s+/).filter(Boolean);
  return {
    ...acc,
    email,
    display_email: email,
    firstName: firstName || parts[0] || '',
    lastName: lastName || parts.slice(1).join(' ') || '',
    password: String(acc.password || acc.pass || acc.secret || '').trim(),
    pass: String(acc.pass || acc.password || acc.secret || '').trim(),
    status: String(acc.status || acc.teepublic_status || acc.creaty_phase || '').trim() || 'pending',
    sessionId: String(acc.sessionId || acc.emailcoreSessionId || acc.id || '').trim(),
    id: String(acc.sessionId || acc.emailcoreSessionId || acc.id || email).trim(),
  };
}

async function loadImportedSessionAccounts() {
  const accounts = await loadAccountsFromStorage();
  return (Array.isArray(accounts) ? accounts : [])
    .map(normalizeImportedSessionAccount)
    .filter((acc) => acc.email);
}

async function updateImportedAccountStatus(email, nextStatus) {
  const targetEmail = String(email || '').trim().toLowerCase();
  const normalizedStatus = String(nextStatus || '').trim().toLowerCase() === 'inactive' ? 'inactive' : 'active';
  if (!targetEmail) return false;

  const stored = await readStorage(AUT_STORAGE_KEYS);
  const patch = {};
  let changed = false;

  for (const key of AUT_STORAGE_KEYS) {
    const list = Array.isArray(stored[key]) ? stored[key] : null;
    if (!list) continue;
    let localChanged = false;
    const nextList = list.map((acc) => {
      const accEmail = String(acc?.email || acc?.display_email || '').trim().toLowerCase();
      if (!accEmail || accEmail !== targetEmail) return acc;
      localChanged = true;
      changed = true;
      return {
        ...acc,
        status: normalizedStatus,
        teepublic_status: normalizedStatus,
      };
    });
    if (localChanged) patch[key] = nextList;
  }

  if (!changed) return false;
  await writeStorage(patch);
  importedSessionsCache = importedSessionsCache.map((acc) => (
    String(acc?.email || '').trim().toLowerCase() === targetEmail
      ? { ...acc, status: normalizedStatus, teepublic_status: normalizedStatus }
      : acc
  ));
  renderImportedSessionsTable(importedSessionsCache);
  return true;
}

async function deleteImportedSessionAccount(email, options = {}) {
  const targetEmail = String(email || '').trim();
  const targetKey = targetEmail.toLowerCase();
  if (!targetKey) return false;

  if (options.confirm !== false) {
    const ok = window.confirm(creatyT('importedDeleteConfirm', { email: targetEmail }));
    if (!ok) return false;
  }

  const stored = await readStorage(AUT_STORAGE_KEYS);
  const patch = {};
  let removed = 0;

  for (const key of AUT_STORAGE_KEYS) {
    const list = Array.isArray(stored[key]) ? stored[key] : null;
    if (!list) continue;
    const nextList = list.filter((acc) => {
      const accKey = String(acc?.email || acc?.display_email || '').trim().toLowerCase();
      const keep = accKey !== targetKey;
      if (!keep) removed += 1;
      return keep;
    });
    patch[key] = nextList;
  }

  if (Object.keys(patch).length) {
    await writeStorage(patch);
  }

  await new Promise((resolve) => {
    chrome.storage.local.remove(`${SCHEDULE_KEY_PREFIX}${targetKey}`, resolve);
  });

  await sendCreatyAction('CREATY_REMOVE_FROM_QUEUE', { email: targetEmail }).catch(() => null);
  await chrome.runtime.sendMessage({
    action: 'EMAILCORE_REMOVE_ACCOUNT',
    email: targetEmail,
    platform: 'teepublic',
  }).catch(() => null);

  importedSessionsCache = importedSessionsCache.filter((acc) => (
    String(acc?.email || acc?.display_email || '').trim().toLowerCase() !== targetKey
  ));
  renderImportedSessionsTable(importedSessionsCache);
  await refreshQueue('aut').catch(() => null);
  await refreshCreatyDashboard(false).catch(() => null);

  if (options.log !== false) {
    appendLogLine(creatyT('importedDeleteOk', { email: targetEmail }), removed ? 'success' : 'warn');
    creatyHelpers.showToast?.(creatyT('importedDeleteOk', { email: targetEmail }));
  }
  return true;
}

function getImportedBulkEmails(scope = 'selected') {
  const expectedType = activeCreatyAccountSourceTab;
  const filteredRows = creatyDashRowsCache.filter(row => {
    const sType = row.sourceType || 'normal';
    if (sType !== expectedType) return false;
    
    const query = (expectedType === 'creaty' ? creatyTabCreatySearchQuery : creatyTabNormalSearchQuery).trim().toLowerCase();
    if (query) {
      const email = String(row.email || '').toLowerCase();
      const name = String(row.storeTitle || row.displayName || '').toLowerCase();
      if (!email.includes(query) && !name.includes(query)) return false;
    }
    return true;
  });

  if (scope === 'all') {
    return filteredRows.map((row) => String(row.email || '').trim()).filter(Boolean);
  }

  const activeSelSet = activeCreatyAccountSourceTab === 'creaty' ? selectedCreatyTabCreatyAccountIds : selectedCreatyTabNormalAccountIds;
  return filteredRows
    .map((row) => String(row.email || '').trim().toLowerCase())
    .filter((email) => activeSelSet.includes(email));
}

async function runImportedBulkAction(action, scope = 'selected') {
  const lang = getCreatyUiLang();
  const emails = getImportedBulkEmails(scope);
  if (!emails.length) {
    creatyHelpers.showToast?.(creatyT('importedBulkNoSelection'), 'warn');
    appendLogLine(creatyT('importedBulkNoSelection'), 'warn');
    return;
  }

  if (action === 'delete') {
    const ok = window.confirm(creatyT('importedBulkDeleteConfirm', { count: emails.length }));
    if (!ok) return;
  }

  const actionLabel = action === 'signup'
    ? creatyT('importedSignup')
    : action === 'store'
      ? creatyT('importedApplyStore')
      : creatyT('importedDelete');
  appendLogLine(creatyT('importedBulkStarted', { action: actionLabel, count: emails.length }), 'info');

  const activeSelSet = activeCreatyAccountSourceTab === 'creaty' ? selectedCreatyTabCreatyAccountIds : selectedCreatyTabNormalAccountIds;

  for (const email of emails) {
    const normEmail = email.toLowerCase().trim();
    if (action === 'signup') {
      await startSignupFromImportedSession(email);
    } else if (action === 'store') {
      await startStoreAutomationForImportedSession(email);
    } else if (action === 'delete') {
      await deleteImportedSessionAccount(email, { confirm: false, log: false });
      const idx = activeSelSet.indexOf(normEmail);
      if (idx !== -1) activeSelSet.splice(idx, 1);
    }
  }

  const storageKey = activeCreatyAccountSourceTab === 'creaty' ? 'selectedCreatyTabCreatyAccountIds' : 'selectedCreatyTabNormalAccountIds';
  await new Promise(resolve => {
    chrome.storage.local.set({ [storageKey]: activeSelSet }, resolve);
  });

  await refreshCreatyDashboard(false);
  creatyHelpers.showToast?.(lang === 'ar' ? `تم تنفيذ العملية بنجاح` : `Action completed successfully`, 'success');
}

