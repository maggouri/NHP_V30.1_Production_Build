function getCreatyUiLang() {
  const lang = String(document.documentElement.lang || 'ar').toLowerCase();
  return lang.startsWith('en') ? 'en' : 'ar';
}

function formatLtrIsolate(value) {
  return `\u2066${String(value ?? '')}\u2069`;
}

function creatyT(key, vars = {}) {
  const dict = CREATY_UI_I18N[getCreatyUiLang()] || CREATY_UI_I18N.ar;
  let text = dict[key] || CREATY_UI_I18N.en[key] || key;
  Object.entries(vars).forEach(([k, v]) => {
    const rendered = k === 'port' ? formatLtrIsolate(v) : String(v);
    text = text.replace(`{${k}}`, rendered);
  });
  return text;
}

function applyCreatyI18n() {
  document.querySelectorAll('[data-creaty-i18n]').forEach((el) => {
    const key = el.getAttribute('data-creaty-i18n');
    if (key) el.textContent = creatyT(key);
  });
  document.querySelectorAll('[data-creaty-i18n-placeholder]').forEach((el) => {
    const key = el.getAttribute('data-creaty-i18n-placeholder');
    if (key) el.placeholder = creatyT(key);
  });
  document.querySelectorAll('[data-creaty-i18n-title]').forEach((el) => {
    const key = el.getAttribute('data-creaty-i18n-title');
    if (key) el.title = creatyT(key);
  });
}

