    return;
  }
  if (!account.email || !account.password) {
    appendLogLine(`${creatyT('importedMissingFields')}: ${account.email || email}`, 'warn');
    return;
  }

  const selectedEmail = $('creaty-store-account')?.value?.trim();
  let profile = null;
  if (selectedEmail && selectedEmail.toLowerCase() === account.email.toLowerCase()) {
    profile = readStoreFormProfile();
    if (profile.title) {
      await sendCreatyAction('CREATY_SAVE_STORE_PROFILE', { accountEmail: account.email, profile });
      storeProfileDraft = profile;
    }
  }
  if (!profile?.title) profile = await loadStoreProfileForEmail(account.email);
  if (!profile?.title) {
    setStoreStatus(creatyT('scheduleStoreProfileRequired'), 'err');
    appendLogLine(creatyT('scheduleStoreProfileRequired'), 'error');
    return;
  }

  appendLogLine(creatyT('storeApplyStarted', { email: account.email }), 'info');
  setStoreStatus(creatyT('storeApplyStarted', { email: account.email }), 'busy');
  startStoreAutomationPolling();

  const res = await fetch(`${CREATY_SERVER_BASE}/store-automation/start`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      email: account.email,
      display_email: account.email,
      password: account.password,
      pass: account.password,
      storeProfile: profile,
      showBrowser: true,
    }),
  });
  const data = await res.json().catch(() => ({}));
  if (!res.ok || data?.success === false) {
    const err = data?.error || `Creaty server HTTP ${res.status}`;
    renderStoreAutomationStatus(data?.state || { status: 'error', phase: 'ERROR', email: account.email, message: err, error: err });
    setStoreStatus(creatyT('storeApplyFailed', { error: err }), 'err');
    stopStoreAutomationPolling();
    return;
  }
  renderStoreAutomationStatus(data?.state || { status: 'done', phase: 'DONE', email: account.email, message: creatyT('storeApplyDone', { email: account.email }) });
  setStoreStatus(creatyT('storeApplyDone', { email: account.email }), 'ok');
  stopStoreAutomationPolling();
}

function renderPhaseBadge(phase, skipReason) {
