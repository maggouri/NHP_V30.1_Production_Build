  });
}

function isCreatyQueueMessage(text) {
  return /another signup is running|في الانتظار|queue position|طابور creaty/i.test(String(text || ''));
}

function normalizeCreatyLogLevel(text, level = 'info') {
  if (level === 'error' && isCreatyQueueMessage(text)) return 'info';
  if (level === 'warn' && /another signup is running/i.test(String(text || ''))) return 'info';
  return level;
}

function formatCreatyActionError(raw) {
  const text = String(raw || '').trim();
  if (!text) {
    return 'لا رد من خدمة الخلفية — أعد تحميل الإضافة من chrome://extensions';
  }
  if (/another signup is running/i.test(text)) {
    return creatyT('queueWaitingGeneric');
  }
  if (/message port closed|port closed before a response was received/i.test(text)) {
    return 'انقطع الاتصال بخدمة الخلفية (Service Worker) — أعد تحميل الإضافة من chrome://extensions. هذا ليس خطأ Creaty Server.';
  }
  if (/receiving end does not exist|could not establish connection/i.test(text)) {
    return 'انقطع الاتصال بـ Service Worker — أعد تحميل الإضافة (Reload) من chrome://extensions ثم أعد فتح تبويب NHP';
  }
  if (/store_generator_not_loaded|creaty_store_generator_not_loaded/i.test(text)) {
    return 'وحدة توليد المتجر غير محمّلة — أعد تحميل الإضافة (Reload) من chrome://extensions';
  }
  if (/handlers not loaded|creaty handlers not loaded/i.test(text)) {
    return 'معالج CREATY غير محمّل — أعد تحميل الإضافة (Reload) من chrome://extensions';
  }
  if (/creaty server offline|3020|econnrefused|failed to fetch.*3020|networkerror/i.test(text)) {
    return 'Creaty Server غير متصل على المنفذ 3020 — شغّله من AUT أو Start_Creaty_Server.cmd';
  }
  if (/token missing|creaty token/i.test(text)) {
    return 'توكن CREATY غير متزامن — افتح لوحة الموقع → CREATY → مزامنة الإضافة';
  }
  if (/no_response/i.test(text)) {
    return 'لا رد من الخلفية — انتظر ثانية ثم أعد المحاولة، أو أعد تحميل الإضافة';
  }
  if (/model_unavailable|unknown provider|claude-sonnet-4-6/i.test(text)) {
    return creatyT('supervisorChatModelError');
  }
  if (/ai_unavailable|cliproxy_failed/i.test(text)) {
    return creatyT('supervisorChatAiUnavailable');
  }
  return text;
}

function sendCreatyAction(action, data = {}, retryOnColdStart = true) {
  return new Promise((resolve) => {
    const deliver = (response) => {
      if (!response) {
        resolve({ success: false, error: formatCreatyActionError('no_response') });
        return;
      }
      if (response.success === false && response.error) {
        resolve({ ...response, error: formatCreatyActionError(response.error) });
        return;
      }
      resolve(response);
    };

    const attempt = (allowRetry) => {
      chrome.runtime.sendMessage({ action, ...data }, (response) => {
        const err = chrome.runtime.lastError;
        if (err) {
          const msg = String(err.message || '');
          if (
            allowRetry
            && retryOnColdStart
            && /receiving end does not exist|could not establish connection/i.test(msg)
          ) {
            chrome.runtime.sendMessage({ action: 'PING' }, () => {
              setTimeout(() => attempt(false), 350);
            });
            return;
          }
          resolve({ success: false, error: formatCreatyActionError(msg) });
          return;
        }
        deliver(response);
      });
    };

    attempt(true);
  });
}

async function fetchCreatyWithTimeout(url, options = {}, timeoutMs = 3000) {
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), timeoutMs);
  try {
    return await fetch(url, { ...options, signal: ctrl.signal });
  } finally {
    clearTimeout(timer);
  }
}

function setCreatyServerStatusUi(isOnline, source = 'ping', serverPhase = '', queueMeta = {}) {
