  const queueLength = Number(queueMeta.queueLength) || 0;
  const currentEmail = String(queueMeta.currentEmail || queueMeta.email || '').trim();
  const signature = `${CREATY_SERVER_PORT}|${source}|${isOnline ? '1' : '0'}|${phaseKey}|${queueLength}|${currentEmail}`;
  const changed = signature !== lastCreatyServerSignature;
  lastCreatyServerSignature = signature;

  if (dot) {
    dot.classList.toggle('creaty-server-dot--online', !!isOnline);
    dot.classList.toggle('creaty-server-dot--offline', !isOnline);
