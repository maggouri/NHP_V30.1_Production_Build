    clearInterval(ghostWakePollTimer);
    ghostWakePollTimer = null;
  }
  if (ghostWakeAbortController) {
    try { ghostWakeAbortController.abort(); } catch (_) { /* ignore */ }
    ghostWakeAbortController = null;
  }
}

function formatGhostWakeError(wakeResult) {
  const code = String(wakeResult?.error || '').trim();
  if (code === 'EADDRINUSE' || /EADDRINUSE|address already in use/i.test(code)) {
    return creatyT('ghostServerPortBusy');
  }
  return wakeResult?.message || wakeResult?.error || creatyT('ghostServerWakeFail');
}

function isGhostHealthOk(res, body) {
  if (!res?.ok) return false;
  if (body && typeof body === 'object' && body.ok === false) return false;
  return true;
}

async function tryGhostDirectFetch(path, timeoutMs = 3500) {
  const url = `${GHOST_SERVER_BASE}${path}`;
  try {
    const res = await fetchCreatyWithTimeout(url, { method: 'GET' }, timeoutMs);
    let body = null;
    try { body = await res.json(); } catch (_) { /* non-JSON body ok */ }
    if (isGhostHealthOk(res, body)) {
      return { online: true, endpoint: path, via: 'direct', port: GHOST_SERVER_PORT };
    }
    console.warn(`[CREATY Ghost] رد غير مقبول من ${url} — HTTP ${res.status}`);
  } catch (err) {
    console.warn(`[CREATY Ghost] فشل الاتصال المباشر بـ ${url}: ${err?.message || err}`);
  }
  return { online: false };
}

async function pingGhostFromBackground(port = GHOST_SERVER_PORT) {
  try {
    const res = await sendCreatyAction('CREATY_PING_GHOST', { port });
    if (!res || res.success === false) {
      console.warn('[CREATY Ghost] فشل ping عبر background:', res?.error || res?.message || 'ping_failed');
      return { online: false, error: res?.error || res?.message || 'ping_failed' };
    }
    return {
      online: !!res.online,
      port: res.port || port,
      endpoint: res.endpoint || '/ping',
      via: 'background',
    };
  } catch (err) {
    console.warn('[CREATY Ghost] خطأ ping عبر background:', err?.message || err);
    return { online: false, error: String(err?.message || err) };
  }
}

async function probeGhostServer(port = GHOST_SERVER_PORT) {
  for (const path of GHOST_HEALTH_PATHS) {
    const direct = await tryGhostDirectFetch(path);
    if (direct.online) return direct;
  }
  return pingGhostFromBackground(port);
}

async function pingGhostFromUi(port = GHOST_SERVER_PORT) {
  return probeGhostServer(port);
}

async function pollGhostStatusOnce() {
  if (ghostServerWakePending) return;
  if (ghostServerCheckInFlight) return ghostServerCheckInFlight;
  ghostServerCheckInFlight = (async () => {
    const ping = await probeGhostServer(GHOST_SERVER_PORT);
    setGhostServerStatusUi(!!ping.online, ping.online ? (ping.endpoint || 'ping') : 'offline');
  })();
  try {
    return await ghostServerCheckInFlight;
  } finally {
    ghostServerCheckInFlight = null;
  }
}

function sendCreatyActionWithTimeout(action, data, timeoutMs) {
  return Promise.race([
    sendCreatyAction(action, data),
    new Promise((resolve) => {
      setTimeout(() => resolve({
        success: false,
        error: 'wake_timeout',
        message: creatyT('ghostServerWakeTimeout'),
      }), timeoutMs);
    }),
  ]);
}

async function checkGhostServerStatusNow() {
  return pollGhostStatusOnce();
}

function finishGhostWakeAttempt(attemptId, success, toastMsg = '') {
  if (attemptId !== ghostWakeAttemptId) return;
  clearGhostWakeSession();
  ghostServerWakePending = false;
  if (success) {
    setGhostServerStatusUi(true, 'wake-ok');
  } else {
    setGhostServerStatusUi(false, 'wake-failed');
    void checkGhostServerStatusNow();
  }
  if (toastMsg) creatyHelpers.showToast?.(toastMsg);
}

async function wakeGhostServerFromColumn() {
  if (ghostServerWakePending) {
    ghostWakeAttemptId += 1;
    clearGhostWakeSession();
    ghostServerWakePending = false;
    setGhostServerStatusUi(false, 'offline');
  }

  const attemptId = ghostWakeAttemptId + 1;
  ghostWakeAttemptId = attemptId;
  ghostServerWakePending = true;
  ghostWakeAbortController = new AbortController();

  setGhostServerStatusUi(false, 'waking');
  creatyHelpers.showToast?.(creatyT('ghostServerConnecting'));

  ghostWakeTimeoutId = setTimeout(() => {
    finishGhostWakeAttempt(attemptId, false, creatyT('ghostServerWakeTimeout'));
  }, GHOST_WAKE_TIMEOUT_MS);

  const pollForGhostOnline = async () => {
    if (attemptId !== ghostWakeAttemptId) return false;
    const ping = await pingGhostFromUi(GHOST_SERVER_PORT);
    if (attemptId !== ghostWakeAttemptId) return false;
    if (ping.online) {
      finishGhostWakeAttempt(attemptId, true, creatyT('ghostServerWakeOk'));
      return true;
    }
    return false;
  };

  try {
    const wakeResult = await sendCreatyActionWithTimeout('wake_server', {
      platform: 'teepublic',
      port: GHOST_SERVER_PORT,
    }, GHOST_WAKE_TIMEOUT_MS);

    if (attemptId !== ghostWakeAttemptId) return;

    if (wakeResult?.success === false && !wakeResult?.pending) {
      finishGhostWakeAttempt(attemptId, false, formatGhostWakeError(wakeResult));
      return;
    }

    if (await pollForGhostOnline()) return;

    await new Promise((r) => { setTimeout(r, GHOST_POLL_INTERVAL_MS); });
    if (attemptId !== ghostWakeAttemptId) return;
    if (await pollForGhostOnline()) return;

    ghostWakePollTimer = setInterval(() => {
      void pollForGhostOnline().then((ok) => {
        if (ok && ghostWakePollTimer) {
          clearInterval(ghostWakePollTimer);
          ghostWakePollTimer = null;
        }
      });
    }, GHOST_POLL_INTERVAL_MS);
  } catch (_) {
    if (attemptId === ghostWakeAttemptId) {
      finishGhostWakeAttempt(attemptId, false, creatyT('ghostServerWakeFail'));
    }
  }
}

