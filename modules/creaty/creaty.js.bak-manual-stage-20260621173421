async function loadSettings() {
  const items = await readStorage(Object.values(STORAGE_KEYS));
  const apiInput = $('creaty-api-base');
  const batchInput = $('creaty-batch-size');
  const skipInput = $('creaty-skip-registered');
  const showBrowserInput = $('creaty-show-browser');
  const autoProxyWarehouseInput = $('creaty-auto-proxy-warehouse');
  const proxyInput = $('creaty-default-proxy');
  const referralInput = $('creaty-referral-urls');
  const apiLabel = $('creaty-api-label');
  const apiBase = items[STORAGE_KEYS.apiBase] || 'http://localhost:3000';
  if (apiInput) apiInput.value = apiBase;
  if (batchInput) batchInput.value = String(items[STORAGE_KEYS.batchSize] || 5);
  if (skipInput) {
    skipInput.checked = false;
    if (items[STORAGE_KEYS.skipRegistered] === true) {
      await writeStorage({ [STORAGE_KEYS.skipRegistered]: false });
    }
  }
  if (showBrowserInput) {
    showBrowserInput.checked = items[STORAGE_KEYS.showBrowser] !== false;
  }
  if (autoProxyWarehouseInput) {
    autoProxyWarehouseInput.checked = items[STORAGE_KEYS.autoProxyWarehouse] === true;
  }
  if (proxyInput) {
    proxyInput.value = String(items[STORAGE_KEYS.defaultProxy] || '').trim();
  }
  if (referralInput) {
    referralInput.value = formatReferralUrlsForInput(items[STORAGE_KEYS.referralUrls] || '');
  }
  if (apiLabel) {
    apiLabel.textContent = apiBase;
    apiLabel.title = 'EmailCore activation API (Render) — Creaty browser driver stays on 127.0.0.1:3020';
  }
  return items;
}

async function saveSettings() {
  const apiBase = $('creaty-api-base')?.value?.trim() || 'http://localhost:3000';
  const batchSize = Math.min(50, Math.max(1, parseInt($('creaty-batch-size')?.value, 10) || 5));
  const skipAlreadyRegistered = $('creaty-skip-registered')?.checked === true;
  const showBrowser = $('creaty-show-browser')?.checked !== false;
  const useAutoProxyWarehouse = $('creaty-auto-proxy-warehouse')?.checked === true;
  const defaultProxy = $('creaty-default-proxy')?.value?.trim() || '';
  const referralUrls = normalizeReferralUrls($('creaty-referral-urls')?.value || '');
  await writeStorage({
    [STORAGE_KEYS.apiBase]: apiBase,
    [STORAGE_KEYS.batchSize]: batchSize,
    [STORAGE_KEYS.skipRegistered]: skipAlreadyRegistered,
    [STORAGE_KEYS.showBrowser]: showBrowser,
    [STORAGE_KEYS.autoProxyWarehouse]: useAutoProxyWarehouse,
    [STORAGE_KEYS.defaultProxy]: defaultProxy,
    [STORAGE_KEYS.referralUrls]: referralUrls,
  });
  const referralInput = $('creaty-referral-urls');
  if (referralInput) referralInput.value = formatReferralUrlsForInput(referralUrls);
  const apiLabel = $('creaty-api-label');
  if (apiLabel) apiLabel.textContent = apiBase;
  return { apiBase, batchSize, skipAlreadyRegistered, showBrowser, useAutoProxyWarehouse, defaultProxy, referralUrls };
}

async function pollRunnerState() {
  const state = await sendCreatyAction('CREATY_GET_STATE');
  if (state?.success) {
    updateRunnerUi(state);
  }
}

function wireCreatyUi() {
  if (creatyUiWired) return;
  creatyUiWired = true;

  $('creaty-pull-aut')?.addEventListener('click', async () => {
    await pullFromAut();
  });

  $('creaty-refresh-queue')?.addEventListener('click', async () => {
    await saveSettings();
    await refreshQueue('aut');
  });

  $('creaty-queue-preview')?.addEventListener('click', (e) => {
    const skipBtn = e.target.closest('.creaty-queue-skip-btn');
    const deleteBtn = e.target.closest('.creaty-queue-delete-btn');
    if (skipBtn?.dataset?.email) {
      void handleQueueSkip(decodeURIComponent(skipBtn.dataset.email));
      return;
    }
    if (deleteBtn?.dataset?.email) {
      void handleQueueDelete(decodeURIComponent(deleteBtn.dataset.email));
    }
  });

  $('creaty-start-runner')?.addEventListener('click', async () => {
    const startBtn = $('creaty-start-runner');
    if (startBtn?.disabled) return;
    const { apiBase, batchSize, skipAlreadyRegistered, showBrowser, useAutoProxyWarehouse, defaultProxy, referralUrls } = await saveSettings();
    appendLogLine(`Starting signup runner (batch ${batchSize})…`, 'info');
    const serverPing = await sendCreatyAction('CREATY_PING_SERVER');
    if (serverPing?.online === false) {
      appendLogLine(formatCreatyActionError(serverPing.error || `Creaty Server offline (${CREATY_SERVER_PORT})`), 'warn');
    }
    const result = await sendCreatyAction('CREATY_START_RUNNER', {
      apiBase,
      batchSize,
      source: 'aut',
      skipAlreadyRegistered,
      showBrowser,
      useAutoProxyWarehouse,
      defaultProxy,
      referralUrls,
    });
    if (!result || result.success === false) {
      appendLogLine(result?.error || formatCreatyActionError('no_response'), 'error');
      return;
    }
    updateRunnerUi(result);
    appendLogLine('Runner started', 'success');
  });

  $('creaty-stop-runner')?.addEventListener('click', async () => {
    const result = await sendCreatyAction('CREATY_STOP_RUNNER');
    updateRunnerUi(result);
    appendLogLine('Runner stop requested', 'warn');
  });

  $('creaty-api-base')?.addEventListener('change', () => saveSettings());
  $('creaty-batch-size')?.addEventListener('change', () => saveSettings());
  $('creaty-skip-registered')?.addEventListener('change', () => saveSettings());
  $('creaty-show-browser')?.addEventListener('change', () => saveSettings());
  $('creaty-auto-proxy-warehouse')?.addEventListener('change', () => saveSettings());
  $('creaty-default-proxy')?.addEventListener('change', () => saveSettings());
  $('creaty-save-referral-urls')?.addEventListener('click', async () => {
    const { referralUrls } = await saveSettings();
    appendLogLine(creatyT('referralUrlsSaved', { n: referralUrls.length }), 'success');
    creatyHelpers.showToast?.(creatyT('referralUrlsSaved', { n: referralUrls.length }));
  });

  // CREATY Dashboard Tab click events
  $('creaty-tab-creaty-btn')?.addEventListener('click', () => {
    activeCreatyAccountSourceTab = 'creaty';
    chrome.storage.local.set({ activeCreatyAccountSourceTab: 'creaty' });
    rerenderCreatyDashboardTable();
  });

  $('creaty-tab-normal-btn')?.addEventListener('click', () => {
    activeCreatyAccountSourceTab = 'normal';
    chrome.storage.local.set({ activeCreatyAccountSourceTab: 'normal' });
    rerenderCreatyDashboardTable();
  });

  // Search input
  $('creaty-accounts-search')?.addEventListener('input', (e) => {
    const val = e.target.value;
    if (activeCreatyAccountSourceTab === 'creaty') {
      creatyTabCreatySearchQuery = val;
      chrome.storage.local.set({ creatyTabCreatySearchQuery: val });
    } else {
      creatyTabNormalSearchQuery = val;
      chrome.storage.local.set({ creatyTabNormalSearchQuery: val });
    }
    rerenderCreatyDashboardTable();
  });

  // Select all visible checkbox
  $('creaty-dash-check-visible')?.addEventListener('change', (event) => {
    const checked = !!event.target?.checked;
    const expectedType = activeCreatyAccountSourceTab;
    const filteredRows = creatyDashRowsCache.filter(row => {
      const sType = row.sourceType || 'normal';
      if (sType !== expectedType) return false;
      
      const query = (expectedType === 'creaty' ? creatyTabCreatySearchQuery : creatyTabNormalSearchQuery).trim().toLowerCase();
      if (query) {
        const email = String(row.email || '').toLowerCase();
        const name = String(row.storeTitle || row.displayName || '').toLowerCase();
        if (!email.includes(query) && !name.includes(query)) return false;
      }
      return true;
    });

    const activeSelSet = activeCreatyAccountSourceTab === 'creaty' ? selectedCreatyTabCreatyAccountIds : selectedCreatyTabNormalAccountIds;

    filteredRows.forEach(row => {
      if (!row.email) return;
      const email = row.email.trim().toLowerCase();
      const idx = activeSelSet.indexOf(email);
      if (checked) {
        if (idx === -1) activeSelSet.push(email);
      } else {
        if (idx !== -1) activeSelSet.splice(idx, 1);
      }
    });

    const storageKey = activeCreatyAccountSourceTab === 'creaty' ? 'selectedCreatyTabCreatyAccountIds' : 'selectedCreatyTabNormalAccountIds';
    chrome.storage.local.set({ [storageKey]: activeSelSet }, () => {
      rerenderCreatyDashboardTable();
    });
  });

  // Select all / clear buttons
  $('creaty-dash-select-all')?.addEventListener('click', () => {
    const expectedType = activeCreatyAccountSourceTab;
    const filteredRows = creatyDashRowsCache.filter(row => {
      const sType = row.sourceType || 'normal';
      if (sType !== expectedType) return false;
      
      const query = (expectedType === 'creaty' ? creatyTabCreatySearchQuery : creatyTabNormalSearchQuery).trim().toLowerCase();
      if (query) {
        const email = String(row.email || '').toLowerCase();
        const name = String(row.storeTitle || row.displayName || '').toLowerCase();
        if (!email.includes(query) && !name.includes(query)) return false;
      }
      return true;
    });

    const activeSelSet = activeCreatyAccountSourceTab === 'creaty' ? selectedCreatyTabCreatyAccountIds : selectedCreatyTabNormalAccountIds;

    filteredRows.forEach(row => {
      if (!row.email) return;
      const email = row.email.trim().toLowerCase();
      if (!activeSelSet.includes(email)) activeSelSet.push(email);
    });

    const storageKey = activeCreatyAccountSourceTab === 'creaty' ? 'selectedCreatyTabCreatyAccountIds' : 'selectedCreatyTabNormalAccountIds';
    chrome.storage.local.set({ [storageKey]: activeSelSet }, () => {
      rerenderCreatyDashboardTable();
    });
  });

  $('creaty-dash-clear-selection')?.addEventListener('click', () => {
    const activeSelSet = activeCreatyAccountSourceTab === 'creaty' ? selectedCreatyTabCreatyAccountIds : selectedCreatyTabNormalAccountIds;
    activeSelSet.length = 0;

    const storageKey = activeCreatyAccountSourceTab === 'creaty' ? 'selectedCreatyTabCreatyAccountIds' : 'selectedCreatyTabNormalAccountIds';
    chrome.storage.local.set({ [storageKey]: [] }, () => {
      rerenderCreatyDashboardTable();
    });
  });

  // Bulk action buttons
  $('creaty-dash-signup-selected')?.addEventListener('click', () => { void runImportedBulkAction('signup', 'selected'); });
  $('creaty-dash-delete-selected')?.addEventListener('click', () => { void runImportedBulkAction('delete', 'selected'); });
  $('creaty-dash-store-selected')?.addEventListener('click', () => { void runImportedBulkAction('store', 'selected'); });
  $('creaty-dash-signup-all')?.addEventListener('click', () => { void runImportedBulkAction('signup', 'all'); });
  $('creaty-dash-delete-all')?.addEventListener('click', () => { void runImportedBulkAction('delete', 'all'); });
  $('creaty-dash-store-all')?.addEventListener('click', () => { void runImportedBulkAction('store', 'all'); });

  // Dashboard row selection callback delegated on creaty-dash-tbody
  $('creaty-dash-tbody')?.addEventListener('click', async (event) => {
    const selectEl = event.target.closest('.creaty-dash-row-check');
    if (selectEl?.dataset?.selectEmail) {
      const email = decodeURIComponent(selectEl.dataset.selectEmail).trim().toLowerCase();
      const activeSelSet = activeCreatyAccountSourceTab === 'creaty' ? selectedCreatyTabCreatyAccountIds : selectedCreatyTabNormalAccountIds;
      const idx = activeSelSet.indexOf(email);
      if (selectEl.checked) {
        if (idx === -1) activeSelSet.push(email);
      } else {
        if (idx !== -1) activeSelSet.splice(idx, 1);
      }
      
      const storageKey = activeCreatyAccountSourceTab === 'creaty' ? 'selectedCreatyTabCreatyAccountIds' : 'selectedCreatyTabNormalAccountIds';
      chrome.storage.local.set({ [storageKey]: activeSelSet }, () => {
        rerenderCreatyDashboardTable();
      });
      return;
    }
    const statusBtn = event.target.closest('.creaty-imported-status-badge');
    if (statusBtn?.dataset?.statusEmail) {
      event.preventDefault();
      const current = String(statusBtn.dataset.statusValue || 'inactive').toLowerCase();
      const nextStatus = current === 'active' ? 'inactive' : 'active';
      const ok = await updateImportedAccountStatus(decodeURIComponent(statusBtn.dataset.statusEmail), nextStatus);
      if (!ok) {
        creatyHelpers.showToast?.('Status update failed', 'error');
      }
      return;
    }

    const toggleBtn = event.target.closest('.creaty-imported-password-toggle');
    if (toggleBtn?.dataset?.email) {
      event.preventDefault();
      toggleImportedPasswordVisibility(decodeURIComponent(toggleBtn.dataset.email));
      return;
    }

    const passwordStoreBtn = event.target.closest('.creaty-imported-password-store-btn');
    if (passwordStoreBtn?.dataset?.storeEmail) {
      event.preventDefault();
      if (passwordStoreBtn.disabled) return;
      passwordStoreBtn.disabled = true;
      try {
        await waitMs(getImportedActionDelay());
        await openStoreGeneratorForImportedSession(decodeURIComponent(passwordStoreBtn.dataset.storeEmail));
      } catch (err) {
        const message = err?.message || String(err || 'store_open_failed');
        appendLogLine(`Store generator open failed: ${message}`, 'error');
        creatyHelpers.showToast?.(message, 'error');
      } finally {
        passwordStoreBtn.disabled = false;
      }
      return;
    }

    const copyEl = event.target.closest('.creaty-imported-copyable');
    if (copyEl?.dataset?.copyText) {
      event.preventDefault();
      await copyImportedFieldValue(copyEl);
      return;
    }

    const btn = event.target.closest('.creaty-imported-signup-btn');
    if (!btn?.dataset?.email || btn.disabled) return;
    void startSignupFromImportedSession(decodeURIComponent(btn.dataset.email));
  });

  $('creaty-server-wake-btn')?.addEventListener('click', () => {
    void wakeCreatyServerFromColumn();
  });

  startCreatyServerMonitor();

  chrome.runtime.onMessage.addListener((msg) => {
    if (msg?.action === 'CREATY_UI_UPDATE') {
      if (msg.phase) {
        const phaseEl = $('creaty-phase');
        if (phaseEl) phaseEl.textContent = msg.phase;
      }
      if (msg.log) appendLogLine(msg.log, normalizeCreatyLogLevel(msg.log, msg.level || 'info'));
      if (msg.state) updateRunnerUi(msg.state);
      if (msg.queue) renderQueuePreview(msg.queue);
      if (msg.phase === 'DONE' || (msg.log && /complete|activated|DONE/i.test(msg.log))) {
        void refreshScheduleUi();
      }
      return;
    }
    if (msg?.action === 'CREATY_SCHEDULE_UPDATE') {
      const email = msg.email || scheduleState?.accountEmail;
      if (msg.schedule && (!email || email === scheduleState?.accountEmail)) {
        scheduleState = msg.schedule;
        syncScheduleControlsFromState();
        renderScheduleProgress();
        renderTimeline();
        renderNextUploadLabel();
      }
      if (msg.log) appendLogLine(msg.log, normalizeCreatyLogLevel(msg.log, msg.level || 'info'));
      return;
    }
    if (msg?.action === 'CREATY_STORE_PROFILE_SAVED') {
      if (msg.log) appendLogLine(msg.log, 'success');
      const selectedEmail = String($('creaty-store-account')?.value || '').trim().toLowerCase();
      const messageEmail = String(msg.email || '').trim().toLowerCase();
      if (msg.profile && selectedEmail && messageEmail && selectedEmail === messageEmail) {
        storeProfileDraft = msg.profile;
        storeAvatarDataUrl = msg.profile.avatarDataUrl || null;
        storeCoverDataUrl = msg.profile.coverDataUrl || null;
        fillStoreOutputFromProfile(msg.profile);
        renderStoreImagePreview('avatar', storeAvatarDataUrl);
        renderStoreImagePreview('cover', storeCoverDataUrl);
        setStoreStatus(creatyT('storeSaved', { email: msg.email }), 'ok');
        renderCreatyFloatingCard();
      }
    }
  });

  chrome.storage.onChanged.addListener((changes, area) => {
    if (area !== 'local' || !changes[CREATY_PROFILE_SYNC_KEY]?.newValue) return;
    const sync = changes[CREATY_PROFILE_SYNC_KEY].newValue;
    const selectedEmail = String($('creaty-store-account')?.value || '').trim().toLowerCase();
    const syncEmail = String(sync?.email || '').trim().toLowerCase();
    if (!sync?.profile || !selectedEmail || !syncEmail || selectedEmail !== syncEmail) return;
    storeProfileDraft = sync.profile;
    storeAvatarDataUrl = sync.profile.avatarDataUrl || null;
    storeCoverDataUrl = sync.profile.coverDataUrl || null;
    fillStoreOutputFromProfile(sync.profile);
    renderStoreImagePreview('avatar', storeAvatarDataUrl);
    renderStoreImagePreview('cover', storeCoverDataUrl);
    setStoreStatus(creatyT('storeSaved', { email: sync.email }), 'ok');
    renderCreatyFloatingCard();
  });

  pollTimer = setInterval(() => {
    pollRunnerState();
    if (scheduleState?.started && !scheduleState.paused) {
      renderScheduleProgress();
      const day = calendarDayFromSchedule(scheduleState);
      if (day !== lastRenderedCalendarDay) renderTimeline();
    }
  }, 2500);
}

export async function initCreatyModule(helpers = {}) {
  creatyHelpers = { ...helpers, t: helpers.t || creatyT };

  // Load state keys
  const stateKeys = await readStorage([
    'activeCreatyAccountSourceTab',
    'selectedCreatyTabCreatyAccountIds',
    'selectedCreatyTabNormalAccountIds',
    'creatyTabCreatySearchQuery',
    'creatyTabNormalSearchQuery'
  ]);
  activeCreatyAccountSourceTab = stateKeys.activeCreatyAccountSourceTab || 'creaty';
  selectedCreatyTabCreatyAccountIds = stateKeys.selectedCreatyTabCreatyAccountIds || [];
  selectedCreatyTabNormalAccountIds = stateKeys.selectedCreatyTabNormalAccountIds || [];
  creatyTabCreatySearchQuery = stateKeys.creatyTabCreatySearchQuery || '';
  creatyTabNormalSearchQuery = stateKeys.creatyTabNormalSearchQuery || '';

  applyCreatyI18n();
  setCreatyServerStatusUi(false, 'init');
  setGhostServerStatusUi(false, 'init');
  wireCreatyUi();
  wireCol1Tabs();
  switchCol1Tab('registration');
  wireCol2Tabs();
  switchCol2Tab('dashboard');
  wireScheduleUi();
  wireStoreGeneratorUi();
  $('creaty-store-card-close')?.addEventListener('click', () => $('creaty-store-card-dialog')?.close());
  await initEmailCoreLibrary();
  wireCreatyFloatingCard();
  wireDesignLibraryColumn(helpers);
  bindCreatyDashboardUi();
  wireSupervisorPanel();
  wireImportedSessionsWheelScroll();
  startGhostHeartbeat();
  await loadSettings();
  await refreshQueue('aut');
  await refreshScheduleUi();
  const state = await sendCreatyAction('CREATY_GET_STATE');
  if (state?.success) updateRunnerUi(state);
  helpers.showToast?.('CREATY ready');

  chrome.storage.onChanged.addListener((changes, area) => {
    if (area !== 'local') return;
    const keys = Object.keys(changes);
    const relevant = keys.some((k) =>
      k === 'ap_accounts_teepublic'
      || k === 'ap_accounts'
      || k.startsWith('creaty_artisan_schedule_')
    );
    if (relevant && isCreatyDashboardActive()) void refreshCreatyDashboard(false);
  });

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stopCreatyDashboardPoll();
    else if (isCreatyDashboardActive()) startCreatyDashboardPoll();
  });
}

export function activateCreatyDashboard() {
  switchCol2Tab('dashboard');
}

export async function NHP_activateCreatyPanel() {
  // Load state keys
  const stateKeys = await readStorage([
    'activeCreatyAccountSourceTab',
    'selectedCreatyTabCreatyAccountIds',
    'selectedCreatyTabNormalAccountIds',
    'creatyTabCreatySearchQuery',
    'creatyTabNormalSearchQuery'
  ]);
  activeCreatyAccountSourceTab = stateKeys.activeCreatyAccountSourceTab || 'creaty';
  selectedCreatyTabCreatyAccountIds = stateKeys.selectedCreatyTabCreatyAccountIds || [];
  selectedCreatyTabNormalAccountIds = stateKeys.selectedCreatyTabNormalAccountIds || [];
  creatyTabCreatySearchQuery = stateKeys.creatyTabCreatySearchQuery || '';
  creatyTabNormalSearchQuery = stateKeys.creatyTabNormalSearchQuery || '';

  applyCreatyI18n();
  setCreatyServerStatusUi(false, 'activate');
  setGhostServerStatusUi(false, 'activate');
  wireCreatyUi();
  wireCol1Tabs();
  switchCol1Tab('registration');
  wireCol2Tabs();
  bindCreatyDashboardUi();
  wireSupervisorPanel();
  wireImportedSessionsWheelScroll();
  startCreatyServerMonitor();
  startGhostHeartbeat();
  void checkCreatyServerStatusNow();
  void checkGhostServerStatusNow();
  wireScheduleUi();
  wireStoreGeneratorUi();
  wireCreatyFloatingCard();
  wireDesignLibraryColumn();
