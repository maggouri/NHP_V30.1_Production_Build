async function runDashboardRowAction(button, action, accountId) {
  const lang = getCreatyUiLang();
  if (!confirmDashboardRowAction(action, accountId, lang)) return;

  const actionKey = `${action}:${String(accountId).trim().toLowerCase()}`;
  if (dashboardRowActionsRunning.has(actionKey)) return;
  dashboardRowActionsRunning.add(actionKey);
  button.disabled = true;
  button.classList.add('is-loading');
  button.setAttribute('aria-busy', 'true');
  appendLogLine(`[DASH] ${action} started: ${accountId}`, 'info');

  const handlers = {
    'login-preview': openLogin,
    'login-session-card': openSessionCard,
    play: runOrResume,
    'store-card': openStoreGeneratorCard,
    'delete-store': deleteStoreGeneration,
    edit: editSchedule,
    'reset-account': resetAccount,
    'delete-account': deleteAccount,
  };

  try {
    const handler = handlers[action];
    if (!handler) throw new Error(`unsupported_row_action:${action}`);
    const result = await handler(accountId);
    if (result?.success === false || result?.ok === false) throw new Error(result.error || `${action}_failed`);
    appendLogLine(`[DASH] ${action} success: ${accountId}`, 'success');
    creatyHelpers.showToast?.(lang === 'ar' ? `تم تنفيذ الإجراء للحساب ${accountId}` : `Action completed for ${accountId}`);
    if (!['login-preview', 'login-session-card', 'store-card', 'edit'].includes(action)) {
      await refreshCreatyDashboard(false);
    }
  } catch (error) {
    const message = formatCreatyActionError(error?.message || error);
    appendLogLine(`[DASH] ${action} failed for ${accountId}: ${message}`, 'error');
    creatyHelpers.showToast?.(message, 'error');
  } finally {
    dashboardRowActionsRunning.delete(actionKey);
    if (button.isConnected) {
      button.disabled = false;
      button.classList.remove('is-loading');
      button.removeAttribute('aria-busy');
    }
  }
}

