function renderStoreAutomationStatus(state = {}) {
  const phase = String(state.phase || 'IDLE').toUpperCase();
  const email = String(state.email || '').trim();
  const message = String(state.message || '').trim();
  const signature = `${state.status || ''}|${phase}|${email}|${message}|${state.error || ''}`;
  if (signature === lastStoreAutomationSignature) return;
  lastStoreAutomationSignature = signature;

  if (message) {
    const level = state.status === 'error' ? 'error' : phase === 'DONE' ? 'success' : 'info';
    appendLogLine(`[STORE] ${phase}${email ? ` ${email}` : ''}: ${message}`, level);
    setStoreStatus(message, state.status === 'error' ? 'err' : phase === 'DONE' ? 'ok' : 'busy');
  }
}

function stopStoreAutomationPolling() {
  if (storeAutomationPollTimer) {
    clearInterval(storeAutomationPollTimer);
    storeAutomationPollTimer = null;
  }
}

function startStoreAutomationPolling() {
  stopStoreAutomationPolling();
  storeAutomationPollTimer = setInterval(async () => {
    try {
      const state = await fetchStoreAutomationStatus();
      renderStoreAutomationStatus(state);
      if (state.status === 'done' || state.status === 'error' || state.phase === 'DONE' || state.phase === 'ERROR') {
        stopStoreAutomationPolling();
      }
    } catch (_err) {
      /* keep the current UI state */
    }
  }, 1500);
}

