export function applyI18n(root, lang, i18n) {
    if (!root) return;
    root.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.getAttribute('data-i18n');
        const text = i18n[lang]?.[key];
        if (text) el.textContent = text;
    });
}
