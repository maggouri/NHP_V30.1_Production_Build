<style>
    .seo-module-root.seo-ui-shell {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        width: 100%;
        min-height: 0;
        box-sizing: border-box;
    }

    .seo-module-root .seo-main-split {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 0.375rem;
        min-height: 0;
    }

    .seo-module-root .seo-col {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        min-width: 0;
        min-height: 0;
    }

    .seo-compact-card {
        border: 1px solid rgba(148, 163, 184, 0.15);
        border-radius: 0.4375rem;
        background: rgba(15, 23, 42, 0.35);
        padding: 0.375rem;
        margin: 0;
        box-shadow: none;
    }

    .seo-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.375rem;
        border: 1px solid rgba(148, 163, 184, 0.15);
        border-radius: 0.4375rem;
        padding: 0.375rem 0.5rem;
        margin: 0;
    }

    .seo-title-group {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        min-width: 0;
        flex-wrap: nowrap;
    }

    .seo-title-text h2 {
        margin: 0;
        font-size: 0.9375rem;
        font-weight: 700;
        line-height: 1.2;
    }

    .seo-compact-badges {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        flex-wrap: wrap;
        margin-inline-start: 0.375rem;
    }

    .seo-mini-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.1875rem;
        border: 1px solid rgba(148, 163, 184, 0.15);
        border-radius: 999px;
        padding: 0.125rem 0.375rem;
        font-size: 0.6875rem;
        line-height: 1.2;
    }

    .seo-mini-badge .stat-value {
        font-size: 0.75rem;
        font-weight: 700;
    }

    .seo-mini-badge .stat-label {
        font-size: 0.6875rem;
        color: var(--text-muted);
    }

    .seo-top-actions {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        flex-wrap: wrap;
    }

    .seo-top-actions .btn {
        height: 1.75rem;
        padding: 0 0.625rem;
        font-size: 0.6875rem;
        border-radius: 0.375rem;
        box-shadow: none;
    }

    .seo-input-toolbar {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        flex-wrap: nowrap;
        min-height: 2.125rem;
    }

    .seo-upload-main-btn {
        height: 2.125rem;
        border: 1px solid rgba(148, 163, 184, 0.15);
        border-radius: 0.375rem;
        background: rgba(108, 99, 255, 0.16);
        font-size: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0 0.625rem;
        box-shadow: none;
    }

    .seo-upload-main-btn-icon {
        font-size: 0.8125rem;
    }

    #seo-cloud-sync-toggle {
        height: 2.125rem;
        font-size: 0.6875rem;
        border-radius: 0.375rem;
        min-width: 5.625rem;
        padding: 0 0.5rem;
        box-shadow: none;
    }

    #seo-upload-msg {
        font-size: 0.6875rem;
        color: var(--text-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .seo-inline-options {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        font-size: 0.6875rem;
    }

    .seo-inline-options > * {
        margin: 0;
    }

    .seo-inline-options label {
        font-size: 0.6875rem !important;
        line-height: 1.2;
        font-weight: 600;
    }

    .seo-queue-scroll {
        max-height: 7rem;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .seo-col-output-inner {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }

    .seo-field-row {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .seo-field-row .field-label {
        margin: 0;
        font-size: 0.6875rem;
        line-height: 1.2;
    }

    .seo-field-row .modern-input {
        min-height: 2rem;
        max-height: 2.1875rem;
        height: 2.1875rem;
        overflow-y: auto;
        font-size: 0.75rem;
        line-height: 1.2;
        padding: 0.25rem 1.75rem 0.25rem 0.5rem;
        border: 1px solid rgba(148, 163, 184, 0.15);
        border-radius: 0.375rem;
        box-shadow: none;
    }

    .seo-field-row textarea.modern-input {
        resize: none;
    }

    .seo-copy-inline {
        position: absolute;
        inset-inline-end: 0.375rem;
        top: 1.375rem;
        width: 1.125rem;
        height: 1.125rem;
        border: none;
        background: transparent;
        box-shadow: none;
        font-size: 0.875rem;
        padding: 0;
        color: var(--text-muted);
    }

    .seo-aesthetic-compact {
        padding: 0.375rem !important;
        margin: 0 !important;
        border-radius: 0.375rem !important;
    }

    .seo-automation-row {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        flex-wrap: wrap;
        font-size: 0.6875rem;
        padding: 0.375rem;
        border: 1px solid rgba(148, 163, 184, 0.15);
        border-radius: 0.4375rem;
    }

    .seo-automation-row label,
    .seo-automation-row span {
        font-size: 0.6875rem;
    }

    .seo-automation-row input[type="radio"],
    .seo-automation-row input[type="checkbox"] {
        width: 0.875rem;
        height: 0.875rem;
    }

    .seo-action-row {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        flex-wrap: wrap;
    }

    .seo-action-row .action-btn,
    .seo-action-row .btn {
        height: 1.875rem;
        min-height: 1.875rem;
        padding: 0 0.75rem;
        border-radius: 0.375rem;
        font-size: 0.75rem;
        box-shadow: none;
        text-shadow: none;
    }

    .seo-action-row #seo-stop-btn {
        width: 1.875rem;
        min-width: 1.875rem;
        padding: 0;
    }

    .seo-loading-inline {
        padding: 0.375rem;
        margin: 0;
    }

    .seo-provider-row {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.25rem;
    }

    .seo-provider-btn {
        min-height: 1.75rem;
        padding: 0.25rem 0.375rem;
        border-radius: 0.375rem;
        border: 1px solid rgba(148, 163, 184, 0.22);
        background: rgba(15, 23, 42, 0.55);
        color: #cbd5e1;
        font-size: 0.625rem;
        font-weight: 700;
        cursor: pointer;
        line-height: 1.2;
        pointer-events: auto;
        position: relative;
        z-index: 2;
    }

    .seo-provider-btn.active {
        border-color: rgba(108, 99, 255, 0.55);
        background: rgba(108, 99, 255, 0.22);
        color: #ede9fe;
        box-shadow: 0 0 0 1px rgba(108, 99, 255, 0.18);
    }

    .seo-provider-note {
        display: block;
        margin-top: 0.3125rem;
        font-size: 0.625rem;
        color: var(--text-muted);
        line-height: 1.35;
    }

    @media (max-width: 6rem) {
        .seo-module-root .seo-main-split {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="seo-module-root seo-ui-shell">
    <div class="seo-header">
        <div class="seo-title-group">
            <div class="seo-icon"><i class="fa-solid fa-brain"></i></div>
            <div class="seo-title-text">
                <h2>محرك الـ SEO الذكي</h2>
            </div>
            <div class="seo-compact-badges">
                <span class="seo-mini-badge"><span class="stat-label">قوة</span><span class="stat-value" id="seo-score">0</span></span>
                <span class="seo-mini-badge"><span class="stat-label">مخاطر</span><span class="stat-value" id="seo-risk" style="color: var(--safe);">Low</span></span>
            </div>
        </div>
        <div class="seo-top-actions">
            <button type="button" id="seo-ai-audit" class="btn"><i class="fa-solid fa-palette"></i> تدقيق</button>
            <button type="button" id="seo-apply-all" class="btn"><i class="fa-solid fa-copy"></i> للكل</button>
            <button type="button" id="seo-goto-autopilot" class="btn" title="الانتقال إلى Autopilot"><i class="fa-solid fa-rocket"></i> AUT <i class="fa-solid fa-arrow-left" style="font-size:0.625rem; opacity:0.7;"></i></button>
        </div>
    </div>

    <div class="seo-main-split">
        <div class="seo-col seo-col-output">
            <div class="seo-compact-card seo-col-output-inner">
                <div id="seo-aesthetic-report" class="glass-card hidden seo-aesthetic-compact" style="border: 1px dashed rgba(236, 72, 153, 0.45);">
                    <h4 style="color: #ec4899; display: flex; align-items: center; gap: 0.25rem; font-weight: 800; margin: 0 0 0.25rem 0;">
                        <i class="fa-solid fa-wand-magic-sparkles"></i> جماليات سريعة
                    </h4>
                    <div id="seo-aesthetic-text"></div>
                </div>

                <div class="seo-field-row">
                    <label class="field-label" for="seo-title"><i class="fa-solid fa-heading"></i> العنوان (Title)</label>
                    <input type="text" id="seo-title" class="modern-input" placeholder="العنوان المقترح سيظهر هنا...">
                    <button type="button" class="seo-copy-inline" id="seo-copy-title" title="نسخ العنوان"><i class="fa-regular fa-copy"></i></button>
                </div>

                <div class="seo-field-row">
                    <label class="field-label" for="seo-main-tag"><i class="fa-solid fa-tag"></i> الطاك الرئيسي (Main Tag)</label>
                    <input type="text" id="seo-main-tag" class="modern-input" placeholder="الكلمة المفتاحية الأساسية...">
                    <button type="button" class="seo-copy-inline" id="seo-copy-main-tag" title="نسخ الطاك"><i class="fa-regular fa-copy"></i></button>
                </div>

                <div class="seo-field-row">
                    <label class="field-label" for="seo-tags">
                        <i class="fa-solid fa-tags"></i> التاجات (Tags)
                        <span><span id="seo-label-tags-count">0</span> / 15</span>
                        <span id="seo-verify-pct" class="verify-pct-badge">0%</span>
                    </label>
                    <textarea id="seo-tags" class="modern-input" placeholder="تاجات ذكية مفصولة بفواصل..."></textarea>
                    <button type="button" class="seo-copy-inline" id="seo-copy-tags" title="نسخ التاجات"><i class="fa-regular fa-copy"></i></button>
                </div>

                <div class="seo-field-row">
                    <label class="field-label" for="seo-desc"><i class="fa-solid fa-quote-left"></i> الوصف (Description)</label>
                    <textarea id="seo-desc" class="modern-input" placeholder="وصف تذكاري جذاب مخصص للنيتش..."></textarea>
                    <button type="button" class="seo-copy-inline" id="seo-copy-desc" title="نسخ الوصف"><i class="fa-regular fa-copy"></i></button>
                </div>
            </div>
        </div>

        <div class="seo-col seo-col-source">
            <div class="seo-compact-card">
                <div class="field-label" style="margin: 0 0 0.375rem 0; display: flex; justify-content: space-between; gap: 0.375rem; align-items: center;">
                    <span>إعداد الإدخال</span>
                    <span style="display: inline-flex; gap: 0.25rem;">
                        <button class="btn" id="seo-import-uspto" style="height: 1.5rem; font-size: 0.625rem; padding: 0 0.5rem;">USPTO</button>
                        <button class="btn" id="seo-import-tp" style="height: 1.5rem; font-size: 0.625rem; padding: 0 0.5rem;">TeePublic</button>
                    </span>
                </div>

                <select id="seo-niche-select" class="modern-input modern-select" style="min-height: 1.875rem; height: 1.875rem; padding: 0 0.5rem; font-size: 0.75rem; margin-bottom: 0.375rem;">
                    <option value="">-- اختر نيتش من النتائج السابقة --</option>
                </select>

                <input type="file" id="seo-image-upload" accept="image/*" class="hidden" multiple>
                <div class="seo-input-toolbar">
                    <button type="button" id="seo-upload-trigger" class="seo-upload-main-btn">
                        <i class="fa-solid fa-upload"></i> رفع
                    </button>
                    <button id="seo-cloud-sync-toggle" class="btn">فحص الحالة...</button>
                    <span id="seo-upload-msg">PNG، JPG · رفع جماعي</span>
                </div>

                <div id="seo-queue-container" class="hidden seo-compact-card" style="margin-top: 0.375rem; padding: 0.375rem;">
                    <div class="flex justify-between items-center" style="margin-bottom: 0.25rem;">
                        <span class="text-[0.625rem] font-bold text-primary/80">قائمة التصاميم</span>
                        <span class="flex items-center gap-1">
                            <span class="text-[0.625rem] text-slate-500" id="seo-queue-count">0 ملفات</span>
                            <button id="seo-recover-queue" class="btn btn-icon" title="استعادة تصاميم محفوظة محلياً بعد تعطل الرفع" style="height: 1.375rem; width: 1.375rem; padding: 0;">
                                <i class="fa-solid fa-rotate-left"></i>
                            </button>
                            <button id="seo-clear-queue" class="btn btn-icon" title="حذف القائمة بالكامل" style="height: 1.375rem; width: 1.375rem; padding: 0;">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </span>
                    </div>
                    <div class="seo-queue-scroll">
                        <div id="seo-queue" class="queue-grid"></div>
                    </div>
                </div>

                <div id="seo-option-row" class="seo-inline-options" style="margin-top: 0.375rem;">
                    <span class="flex items-center gap-1">
                        <input type="checkbox" id="seo-force-niche" class="accent-primary" checked>
                        <label for="seo-force-niche">تضمين الكلمة المفتاحية</label>
                    </span>
                </div>

                <div class="seo-compact-card" id="seo-api-keys-card" style="margin-top: 0.375rem; padding: 0.375rem;">
                    <div class="field-label" style="margin: 0 0 0.375rem 0; display: flex; justify-content: space-between; align-items: center; gap: 0.375rem;">
                        <span><i class="fa-solid fa-key"></i> مفاتيح API (SEO)</span>
                        <label style="display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.625rem; font-weight: 600; cursor: pointer;">
                            <input type="checkbox" id="seo-api-keys-show" style="width: 0.8125rem; height: 0.8125rem; accent-color: var(--primary);">
                            إظهار
                        </label>
                    </div>
                    <div class="seo-api-keys-fields" style="display: flex; flex-direction: column; gap: 0.3125rem;">
                        <input type="text" id="seo-api-base-url" class="modern-input" style="min-height: 1.75rem; height: 1.75rem; font-size: 0.6875rem;" placeholder="Base URL" autocomplete="off">
                        <input type="password" id="seo-api-key-gpt" class="modern-input" style="min-height: 1.75rem; height: 1.75rem; font-size: 0.6875rem;" placeholder="NHP API Key" autocomplete="off">
                        <input type="password" id="seo-api-key-gemini" class="modern-input" style="display:none; min-height: 1.75rem; height: 1.75rem; font-size: 0.6875rem;" placeholder="Gemini API Key" autocomplete="off">
                        <input type="password" id="seo-api-key-cursor" class="modern-input" style="display:none; min-height: 1.75rem; height: 1.75rem; font-size: 0.6875rem;" placeholder="Cursor API Key (crsr_...)" autocomplete="off">
                    </div>
                    <div class="seo-api-test-row">
                        <button type="button" id="seo-api-keys-test" class="btn seo-api-test-btn">
                            <i class="fa-solid fa-plug-circle-check"></i> اختبار المفتاح
                        </button>
                        <div class="seo-api-led-group" title="حالة الاتصال">
                            <span class="seo-api-led-label">سيرفر</span>
                            <span id="seo-api-led-server" class="seo-api-test-led" aria-label="حالة السيرفر"></span>
                            <span class="seo-api-led-label">مفتاح</span>
                            <span id="seo-api-led-key" class="seo-api-test-led" aria-label="حالة المفتاح"></span>
                        </div>
                    </div>
                    <button type="button" id="seo-api-keys-save" class="btn" style="width: 100%; margin-top: 0.375rem; height: 1.75rem; font-size: 0.6875rem; background: rgba(108, 99, 255, 0.2); border: 1px solid rgba(108, 99, 255, 0.35); color: #c4b5fd;">
                        <i class="fa-solid fa-floppy-disk"></i> حفظ مفاتيح SEO
                    </button>
                </div>

                <div class="seo-compact-card" id="seo-provider-card" style="margin-top: 0.375rem; padding: 0.375rem;">
                    <div class="field-label" style="margin: 0 0 0.375rem 0;">
                        <i class="fa-solid fa-sliders"></i> طريقة توليد SEO
                    </div>
                    <div class="seo-provider-row" id="seo-provider-row">
                        <button type="button" class="seo-provider-btn active" data-provider="gpt-api" title="NHP local API">NHP API</button>
                        <button type="button" class="seo-provider-btn" data-provider="gemini-api" title="Gemini API Key" style="display:none;">Gemini API</button>
                        <button type="button" class="seo-provider-btn" data-provider="cursor-api" title="Cursor API Key" style="display:none;">Cursor API</button>
                        <button type="button" class="seo-provider-btn" data-provider="gemini-web" title="نافذة Gem / ChatGPT">Gemini Web</button>
                        <button type="button" class="seo-provider-btn" data-provider="local-library" title="مولّد تاجات BubbleSpider (Redbubble) — 15 تاجاً الأكثر شيوعاً">مكتبة محلية</button>
                    </div>
                    <label style="display: inline-flex; align-items: center; gap: 0.3125rem; margin-top: 0.375rem; font-size: 0.625rem; font-weight: 600; cursor: pointer;">
                        <input type="checkbox" id="seo-ai-window-mode-toggle" style="width: 0.8125rem; height: 0.8125rem; accent-color: var(--primary);" checked>
                        نوافذ احتياطية عند فشل المفتاح/API
                    </label>
                    <span id="seo-ai-window-mode-note" class="seo-provider-note">الافتراضي: المفتاح أولاً، ثم فتح Gem/ChatGPT تلقائياً عند الفشل.</span>
                </div>
            </div>

            <div id="seo-loading" class="hidden seo-loading-inline seo-compact-card text-center">
                <div class="spinner-small" style="width: 0.875rem; height: 0.875rem; margin: 0 auto 0.25rem;"></div>
                <span style="font-size: 0.6875rem; color: var(--text-muted);">جاري التحليل الشامل عبر Gemini AI...</span>
            </div>

            <div id="seo-preview-wrap" class="hidden seo-compact-card" style="padding: 0.375rem;">
                <div class="flex items-center gap-2">
                    <img id="seo-img-preview" src="#" style="width: 2rem; height: 2rem; object-fit: cover; border-radius: 0.375rem; border: 1px solid var(--primary);">
                    <div class="flex-1 overflow-hidden min-w-0">
                        <div class="text-[0.625rem] text-primary font-bold uppercase">معاينة التصميم الحالي</div>
                        <div class="text-[0.6875rem] text-white truncate font-medium" id="seo-current-filename">design.png</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="seo-automation-row">
        <span class="flex items-center gap-1">
            <input type="checkbox" id="seo-auto-submit" class="accent-primary">
            <label for="seo-auto-submit">موافقة تلقائية</label>
        </span>
        <span>اللون الافتراضي:</span>
        <label style="display:flex; align-items:center; gap:0.1875rem;">
            <input type="radio" name="seo-default-color" value="Black" class="accent-primary" checked>
            <span>أسود</span>
        </label>
        <label style="display:flex; align-items:center; gap:0.1875rem;">
            <input type="radio" name="seo-default-color" value="White" class="accent-primary">
            <span>أبيض</span>
        </label>
    </div>

    <div id="seo-action-row" class="seo-action-row">
        <button class="action-btn action-btn-primary" id="seo-genBtn" style="background: #6c63ff; border: 1px solid rgba(148, 163, 184, 0.15);">
            <i class="fa-solid fa-wand-magic-sparkles"></i> بدء التحليل
        </button>
        <button class="action-btn action-btn-primary" id="seo-teepublicBtn" style="background: #10b981; border: 1px solid rgba(148, 163, 184, 0.15);">
            <i class="fa-solid fa-play"></i> تشغيل الأتمتة
        </button>
        <button class="btn hidden" id="seo-stop-btn" style="border: 1px solid #ef4444; color: #ef4444; background: transparent;">
            <i class="fa-solid fa-stop-circle"></i>
        </button>
    </div>

    <div id="seo-batch-progress" class="hidden seo-compact-card" style="padding: 0.5rem;">
        <div class="flex justify-between items-center" style="margin-bottom: 0.25rem;">
            <span style="font-size: 0.625rem; font-weight: 700; color: var(--primary);">جاري توليد SEO لجميع التصاميم...</span>
            <span id="seo-batch-status" style="font-size: 0.625rem; color: var(--text-muted);">0 / 0</span>
        </div>
        <div style="width: 100%; height: 0.3125rem; background: rgba(255,255,255,0.05); border-radius: 0.625rem; overflow: hidden;">
            <div id="seo-batch-fill" style="width: 0%; height: 100%; background: #6c63ff; transition: width 0.1s ease;"></div>
        </div>
    </div>

    <div class="alert" id="seo-alert"></div>
</div>
