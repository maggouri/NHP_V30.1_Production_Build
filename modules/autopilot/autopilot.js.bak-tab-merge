function openApAccountToolsPopup(accId, anchorEl) {
    const acc = resolveAccountById(accId);
    if (!acc) return;
    const popup = document.getElementById('ap-account-tools-popup');
    if (!popup) return;
    cancelApAccountToolsHide();
    const anchor = anchorEl
        || apToolsHoverAnchor
        || document.querySelector(`.open-ap-acc-tools-btn[data-id="${accId}"]`);
    apToolsHoverAnchor = anchor || null;
    apToolsPopupAccountId = accId;
    const alias = acc.displayName || acc.storeName || acc.email.split('@')[0];
    const titleEl = document.getElementById('ap-tools-title');
    const emailEl = document.getElementById('ap-tools-email');
    const batchEl = document.getElementById('ap-tools-batch-limit');
    const dailyEl = document.getElementById('ap-tools-daily-limit');
    const dayUsedEl = document.getElementById('ap-tools-day-used');
    const actionsEl = document.getElementById('ap-tools-actions');
    if (titleEl) titleEl.textContent = alias;
    if (emailEl) {
        emailEl.textContent = acc.email;
        emailEl.title = acc.email;
    }
    const runLimit = Number.isFinite(Number(acc.batchLimit)) && Number(acc.batchLimit) > 0 ? Number(acc.batchLimit) : '';
    const dayLimit = Number.isFinite(Number(acc.dailyLimit)) && Number(acc.dailyLimit) > 0 ? Number(acc.dailyLimit) : '';
    const uploadedToday = Number(acc.uploadedTodayCount || 0) || 0;
    if (batchEl) {
        batchEl.value = runLimit;
        batchEl.setAttribute('data-id', acc.id);
    }
    if (dailyEl) {
        dailyEl.value = dayLimit;
        dailyEl.setAttribute('data-id', acc.id);
    }
    if (dayUsedEl) dayUsedEl.textContent = String(uploadedToday);
    if (actionsEl) actionsEl.innerHTML = buildApAccountToolsActionsHtml(acc);
    popup.hidden = false;
    popup.setAttribute('aria-hidden', 'false');
    if (anchor) positionApAccountToolsPopup(anchor);
}

function setupApAccountToolsPopup() {
    const popup = document.getElementById('ap-account-tools-popup');
    if (!popup || popup.dataset.apToolsBound === '1') return;
    popup.dataset.apToolsBound = '1';

    popup.addEventListener('mouseenter', () => cancelApAccountToolsHide());
    popup.addEventListener('mouseleave', () => scheduleApAccountToolsHide());

    popup.addEventListener('click', (e) => {
        if (e.target.closest('[data-ap-tools-close]')) {
            closeApAccountToolsPopup();
            return;
        }
        const openBtn = e.target.closest('.open-ap-browser-btn');
        if (openBtn) {
            const acc = resolveAccountById(openBtn.getAttribute('data-id'));
            if (acc) openAccountBrowser(acc);
            else showToast('⚠️ تعذر العثور على الحساب المطلوب لفتح الجلسة.');
            return;
        }
        const albumsBtn = e.target.closest('.open-ap-albums-btn');
        if (albumsBtn) {
            const acc = resolveAccountById(albumsBtn.getAttribute('data-id'));
            if (acc) launchTeePublicAlbumOrganizerFlow(acc);
            else showToast('⚠️ تعذر العثور على الحساب المطلوب لتشغيل منظم الألبومات.');
            return;
        }
        const moveBtn = e.target.closest('.move-ap-acc-btn');
        if (moveBtn) {
            const id = moveBtn.getAttribute('data-id');
            const dir = moveBtn.getAttribute('data-dir');
            if (id && (dir === 'up' || dir === 'down')) {
                moveAPAccount(id, dir);
                if (apToolsPopupAccountId) {
                    openApAccountToolsPopup(apToolsPopupAccountId, apToolsHoverAnchor);
                }
            }
        }
    });

    popup.addEventListener('change', (e) => {
        const batchInput = e.target.closest('.ap-batch-limit');
        const dailyInput = e.target.closest('.ap-daily-limit');
        if (!batchInput && !dailyInput) return;
        const accId = apToolsPopupAccountId || (batchInput || dailyInput).getAttribute('data-id');
        const acc = autopilotAccounts.find((a) => a.id === accId);
        if (!acc) return;
        if (batchInput) acc.batchLimit = parseInt(batchInput.value, 10) || null;
        if (dailyInput) acc.dailyLimit = parseInt(dailyInput.value, 10) || null;
        saveCurrentAccounts(() => showToast('✅ تم حفظ حدود الرفع للحساب'));
    });

    popup.addEventListener('mousedown', (e) => {
        if (e.target.closest('.ap-limit-input')) e.stopPropagation();
    });

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && popup && !popup.hidden) closeApAccountToolsPopup();
    });

    if (AP.list && AP.list.dataset.apToolsHoverBound !== '1') {
        AP.list.dataset.apToolsHoverBound = '1';
        AP.list.addEventListener('mouseover', (e) => {
            const toolsBtn = e.target.closest('.open-ap-acc-tools-btn');
            if (!toolsBtn || !AP.list.contains(toolsBtn)) return;
            const id = toolsBtn.getAttribute('data-id');
            if (!id) return;
            apToolsHoverAnchor = toolsBtn;
            openApAccountToolsPopup(id, toolsBtn);
        });
        AP.list.addEventListener('mouseout', (e) => {
            const toolsBtn = e.target.closest('.open-ap-acc-tools-btn');
            if (!toolsBtn) return;
            const related = e.relatedTarget;
            const popupEl = document.getElementById('ap-account-tools-popup');
            if (related && (toolsBtn.contains(related) || popupEl?.contains(related))) return;
            scheduleApAccountToolsHide();
        });
    }
}

