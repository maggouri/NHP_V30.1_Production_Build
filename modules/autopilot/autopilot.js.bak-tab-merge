let apToolsPopupAccountId = null;
let apToolsHoverAnchor = null;
let apToolsHideTimer = null;

function cancelApAccountToolsHide() {
    if (apToolsHideTimer) {
        clearTimeout(apToolsHideTimer);
        apToolsHideTimer = null;
    }
}

function scheduleApAccountToolsHide(delayMs = 140) {
    cancelApAccountToolsHide();
    apToolsHideTimer = setTimeout(() => {
        apToolsHideTimer = null;
        closeApAccountToolsPopup();
    }, delayMs);
}

function closeApAccountToolsPopup() {
    cancelApAccountToolsHide();
    const popup = document.getElementById('ap-account-tools-popup');
    if (!popup) return;
    popup.hidden = true;
    popup.setAttribute('aria-hidden', 'true');
    apToolsPopupAccountId = null;
    apToolsHoverAnchor = null;
}

function positionApAccountToolsPopup(anchorEl) {
    const popup = document.getElementById('ap-account-tools-popup');
    const panel = popup?.querySelector('.ap-tools-panel');
    if (!popup || !panel || !anchorEl) return;
    const rect = anchorEl.getBoundingClientRect();
    const panelW = Math.min(320, window.innerWidth - 16);
    const gap = 6;
    let top = rect.bottom + gap;
    let left = rect.right - panelW;
    if (left < 8) left = 8;
    if (left + panelW > window.innerWidth - 8) left = window.innerWidth - panelW - 8;
    const estHeight = 168;
    if (top + estHeight > window.innerHeight - 8) {
        top = Math.max(8, rect.top - gap - estHeight);
    }
    panel.style.top = `${Math.round(top)}px`;
    panel.style.left = `${Math.round(left)}px`;
    panel.style.width = `${Math.round(panelW)}px`;
}

